063a\u06cc\u06cc\u0631\u0627\u062a \u062f\u0631 \u0627\u06cc\u0646 \u0633\u06cc\u0627\u0633\u062a","policy-narengi-child-descr":"\u0633\u0631\u0648\u06cc\u0633 \u0646\u0627\u0631\u0646\u06af\u06cc \u0628\u0631\u0627\u06cc \u06a9\u0648\u062f\u06a9\u0627\u0646 \u0632\u06cc\u0631 \u06f1\u06f3 \u0633\u0627\u0644 \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u0647 \u0646\u0634\u062f\u0647 \u0627\u0633\u062a. \u067e\u0633 \u0645\u0627 \u0628\u0647\u200c\u0637\u0648\u0631 \u0622\u06af\u0627\u0647\u0627\u0646\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0627\u0641\u0631\u0627\u062f \u0632\u06cc\u0631 \u06f1\u06f3 \u0633\u0627\u0644 \u0631\u0627 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u0646\u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645.","policy-narengi-child-title":"\u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u06a9\u0648\u062f\u06a9\u0627\u0646","policy-narengi-choice-descr1":"\u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0645\u0648\u0631\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u062e\u0648\u062f\u060c \u0627\u0646\u062a\u062e\u0627\u0628\u200c\u0647\u0627\u06cc \u0632\u06cc\u0631 \u0631\u0627 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f:","policy-narengi-choice-descr2":"\u0627\u0644\u0641. \u0648\u06cc\u0631\u0627\u06cc\u0634 \u0648 \u062d\u0630\u0641 \u0627\u0637\u0644\u0627\u0639\u0627\u062a: \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0648\u0627\u0631\u062f \u0634\u062f\u0646 \u0628\u0647 \u0635\u0641\u062d\u0647 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062e\u0648\u062f\u060c \u0628\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u0627\u0631\u0628\u0631\u06cc \u062f\u0633\u062a\u0631\u0633\u06cc \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u062f \u0648 \u0622\u0646\u200c\u0647\u0627 \u0631\u0627 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u06cc\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f.","policy-narengi-choice-descr3":"\u0628. \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u062a\u0628\u0644\u06cc\u063a\u0627\u062a: \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0647\u0631 \u0632\u0645\u0627\u0646 \u062e\u0648\u0627\u0633\u062a\u06cc\u062f\u060c \u062f\u0631\u06cc\u0627\u0641\u062a \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0646\u0627\u0631\u0646\u06af\u06cc \u0627\u0632 \u0633\u0645\u062a \u0645\u0627 \u0631\u0627 \u0644\u063a\u0648 \u06a9\u0646\u06cc\u062f.","policy-narengi-choice-title":"\u0627\u0646\u062a\u062e\u0627\u0628\u200c\u0647\u0627\u06cc \u0634\u0645\u0627","policy-narengi-contact-descr1":"\u0627\u06af\u0631 \u062f\u0631\u0628\u0627\u0631\u0647 \u0633\u06cc\u0627\u0633\u062a \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u06cc\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u062e\u0648\u062f \u0633\u0648\u0627\u0644 \u06cc\u0627 \u0646\u06af\u0631\u0627\u0646\u06cc\u200c \u062f\u0627\u0631\u06cc\u062f\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u0645\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u06cc\u0645\u06cc\u0644 support@narengi.com \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u06cc\u062f.","policy-narengi-contact-descr2":"\u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062e\u062f\u0645\u0627\u062a \u0633\u0631\u0648\u06cc\u0633 \u0646\u0627\u0631\u0646\u06af\u06cc\u060c \u0634\u0645\u0627 \u0628\u0627 \u0634\u0631\u0627\u06cc\u0637 \u0627\u06cc\u0646 \u0633\u06cc\u0627\u0633\u062a \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0645\u0648\u0627\u0641\u0642\u062a \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f. \u062f\u0631 \u0646\u062a\u06cc\u062c\u0647 \u0645\u0637\u0627\u0644\u0628 \u0627\u06cc\u0646 \u0635\u0641\u062d\u0647 \u0631\u0627 \u0628\u0647 \u0637\u0648\u0631 \u0645\u0646\u0638\u0645 \u0628\u0631\u0631\u0633\u06cc \u06a9\u0646\u06cc\u062f \u062a\u0627 \u0627\u0632 \u0646\u06a9\u0627\u062a \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u062e\u0648\u062f \u0628\u0627\u062e\u0628\u0631 \u0628\u0627\u0634\u06cc\u062f.","policy-narengi-contact-title":"\u062a\u0645\u0627\u0633 \u0628\u0627 \u0645\u0627","policy-narengi-descr1":"\u0633\u06cc\u0627\u0633\u062a \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0628\u0631\u0627\u06cc Narengi.com \u0648 Maximus GmbH","policy-narengi-descr2":"\u0622\u062e\u0631\u06cc\u0646 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc: 11/06/2023","policy-narengi-descr3":"\u062f\u0631 Narengi \u0648 Maximus GmbH Services\u060c \u0645\u0627 \u0645\u062a\u0639\u0647\u062f\u06cc\u0645 \u0627\u0632 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u0648 \u0627\u0645\u0646\u06cc\u062a \u0645\u0634\u062a\u0631\u06a9\u0627\u0646 \u062e\u0648\u062f \u062d\u0641\u0627\u0638\u062a \u06a9\u0646\u06cc\u0645. \u062f\u0631 \u0627\u06cc\u0646 \u0635\u0641\u062d\u0647 (\u0633\u06cc\u0627\u0633\u062a \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc)\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0633\u06cc\u0627\u0633\u062a\u200c\u0647\u0627\u06cc \u0645\u0627 \u0631\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc\u060c \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0648 \u0627\u0641\u0634\u0627\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0647\u0646\u06af\u0627\u0645 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0646\u0627\u0631\u0646\u06af\u06cc \u0648 \u062a\u0645\u0627\u0634\u0627\u06cc \u0641\u06cc\u0644\u0645 \u0648 \u0633\u0631\u06cc\u0627\u0644 \u062f\u0631 \u0627\u06cc\u0646 \u0648\u0628\u0633\u0627\u06cc\u062a \u0628\u062e\u0648\u0627\u0646\u06cc\u062f. \u0628\u0627 \u062e\u0631\u06cc\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0646\u0627\u0631\u0646\u06af\u06cc \u0648 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0622\u0646\u060c \u0634\u0645\u0627 \u0628\u0627 \u0646\u06a9\u062a\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u062f\u0631 \u0627\u06cc\u0646 \u0633\u06cc\u0627\u0633\u062a\u200c\u0646\u0627\u0645\u0647 \u0645\u06cc\u200c\u062e\u0648\u0627\u0646\u06cc\u062f \u0645\u0648\u0627\u0641\u0642\u062a \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f.","policy-narengi-general-descr1":"\u0647\u0646\u06af\u0627\u0645\u06cc \u06a9\u0647 \u0634\u0645\u0627 \u062f\u0631 \u0646\u0627\u0631\u0646\u06af\u06cc \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0645\u06cc\u200c\u0633\u0627\u0632\u06cc\u062f\u060c \u0645\u0627 \u0646\u0627\u0645\u060c \u0622\u062f\u0631\u0633 \u0627\u06cc\u0645\u06cc\u0644\u060c \u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0648 \u0631\u0645\u0632 \u0639\u0628\u0648\u0631 \u0634\u0645\u0627 \u0631\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645.","policy-narengi-general-descr10":"\u0628\u0631\u0627\u06cc \u0627\u0631\u0633\u0627\u0644 \u0645\u0637\u0627\u0644\u0628 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a\u06cc \u0648 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc\u200c\u0647\u0627\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062e\u062f\u0645\u0627\u062a\u06cc \u06a9\u0647 \u0627\u0632 \u0646\u0627\u0631\u0646\u06af\u06cc \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f. (\u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0647\u0631 \u0632\u0645\u0627\u0646 \u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u06cc\u0646 \u067e\u06cc\u0627\u0645\u200c\u0647\u0627 \u0631\u0627 \u0644\u063a\u0648 \u06a9\u0646\u06cc\u062f.)","policy-narengi-general-descr11":"\u0628\u0631\u0627\u06cc \u0631\u0639\u0627\u06cc\u062a \u0645\u0648\u0627\u0631\u062f \u0642\u0627\u0646\u0648\u0646\u06cc \u0648 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062d\u0642\u0648\u0642\u0645\u0627\u0646.","policy-narengi-general-descr2":"\u0647\u0646\u06af\u0627\u0645\u06cc \u06a9\u0647 \u062f\u0631 \u0646\u0627\u0631\u0646\u06af\u06cc \u0627\u0634\u062a\u0631\u0627\u06a9 \u0641\u0639\u0627\u0644 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a \u0634\u0645\u0627 \u0645\u0627\u0646\u0646\u062f \u062c\u0632\u0626\u06cc\u0627\u062a \u06a9\u0627\u0631\u062a \u0627\u0639\u062a\u0628\u0627\u0631\u06cc \u06cc\u0627 \u062f\u06cc\u06af\u0631 \u0631\u0648\u0634\u200c\u0647\u0627\u06cc \u067e\u0631\u062f\u0627\u062e\u062a \u0631\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u0645\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u0627\u0645\u0644 \u06a9\u0627\u0631\u062a \u0627\u0639\u062a\u0628\u0627\u0631\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0631\u0648\u06cc \u0633\u0631\u0648\u0631\u0647\u0627\u06cc \u062e\u0648\u062f \u0630\u062e\u06cc\u0631\u0647 \u0646\u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645 \u0648 \u0627\u0632 \u067e\u0631\u062f\u0627\u0632\u0634\u06af\u0631 \u067e\u0631\u062f\u0627\u062e\u062a \u0645\u0639\u062a\u0628\u0631\u06cc \u0628\u0631\u0627\u06cc \u0627\u0646\u062c\u0627\u0645 \u0627\u06cc\u0646 \u062a\u0631\u0627\u06a9\u0646\u0634\u200c\u0647\u0627 \u0628\u0647 \u0635\u0648\u0631\u062a \u0627\u0645\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645.","policy-narengi-general-descr3":"\u0645\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u0646\u062d\u0648\u0647 \u062a\u0639\u0627\u0645\u0644 \u0634\u0645\u0627 \u0628\u0627 \u0646\u0627\u0631\u0646\u06af\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0627\u0645\u0644 \u062a\u0627\u0631\u06cc\u062e\u0686\u0647 \u0645\u0634\u0627\u0647\u062f\u0647 \u0634\u0645\u0627\u060c \u062c\u0633\u062a\u062c\u0648\u0647\u0627 \u0648 \u0645\u062d\u062a\u0648\u0627\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0627\u0646\u062a\u062e\u0627\u0628 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f \u0645\u06cc\u200c\u0634\u0648\u062f.","policy-narengi-general-descr4":"\u0645\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062f\u0633\u062a\u06af\u0627\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0627\u0632 \u0622\u0646\u200c\u0647\u0627 \u0628\u0631\u0627\u06cc \u062a\u0645\u0627\u0634\u0627\u06cc \u0646\u0627\u0631\u0646\u06af\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f \u0631\u0627 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u06a9\u0646\u06cc\u0645. \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0627\u0645\u0644 \u0646\u0648\u0639 \u062f\u0633\u062a\u06af\u0627\u0647\u060c \u0633\u06cc\u0633\u062a\u0645 \u0639\u0627\u0645\u0644\u060c \u0648 \u0634\u0646\u0627\u0633\u0647\u200c\u0647\u0627\u06cc \u0645\u0646\u062d\u0635\u0631\u0628\u0647\u200c\u0641\u0631\u062f \u062f\u0633\u062a\u06af\u0627\u0647 \u0634\u0645\u0627 \u0645\u06cc\u200c\u0634\u0648\u062f.","policy-narengi-general-descr5":"\u0645\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062a\u0642\u0631\u06cc\u0628\u06cc \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0628\u0631\u0627\u0633\u0627\u0633 \u0622\u062f\u0631\u0633 IP \u06cc\u0627 \u062a\u0646\u0638\u06cc\u0645\u0627\u062a \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc \u062f\u0633\u062a\u06af\u0627\u0647 \u0634\u0645\u0627 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u06a9\u0646\u06cc\u0645.","policy-narengi-general-descr6":"\u0645\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u06a9\u0647 \u0634\u0645\u0627 \u0647\u0646\u06af\u0627\u0645 \u062a\u0645\u0627\u0633 \u0628\u0627 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u0634\u062a\u0631\u06cc \u06cc\u0627 \u0641\u0631\u0633\u062a\u0627\u062f\u0646 \u0628\u0627\u0632\u062e\u0648\u0631\u062f \u0627\u0631\u0627\u0626\u0647 \u0645\u06cc\u200c\u062f\u0647\u06cc\u062f \u0631\u0627 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645.","policy-narengi-general-descr7":"\u0645\u0627 \u0686\u0637\u0648\u0631 \u0627\u0632 \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645\u061f","policy-narengi-general-descr8":"\u0628\u0631\u0627\u06cc \u0627\u0631\u0627\u0626\u0647\u060c \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0648 \u0628\u0647\u0628\u0648\u062f \u062e\u062f\u0645\u0627\u062a \u067e\u062e\u0634 \u0641\u06cc\u0644\u0645 \u0648 \u0633\u0631\u06cc\u0627\u0644\u060c \u0645\u062b\u0644 \u0634\u062e\u0635\u06cc\u200c\u0633\u0627\u0632\u06cc \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0627\u062a \u0645\u062d\u062a\u0648\u0627.","policy-narengi-general-descr9":"\u0628\u0631\u0627\u06cc \u067e\u0627\u0633\u062e \u0628\u0647 \u067e\u0631\u0633\u0634\u200c\u0647\u0627\u06cc \u0634\u0645\u0627 \u062f\u0631\u0645\u0648\u0631\u062f \u0646\u0627\u0631\u0646\u06af\u06cc \u0648 \u0627\u0631\u0627\u0626\u0647 \u062e\u062f\u0645\u0627\u062a \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0628\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646.","policy-narengi-general-subtitle1":"\u0627\u0644\u0641. \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062d\u0633\u0627\u0628:","policy-narengi-general-subtitle10":"\u062a. \u0631\u0639\u0627\u06cc\u062a \u0642\u0648\u0627\u0646\u06cc\u0646::","policy-narengi-general-subtitle2":"\u0628. \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u067e\u0631\u062f\u0627\u062e\u062a:","policy-narengi-general-subtitle3":"\u067e. \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647:","policy-narengi-general-subtitle4":"\u062a. \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062f\u0633\u062a\u06af\u0627\u0647:","policy-narengi-general-subtitle5":"\u062b. \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0648\u0642\u0639\u06cc\u062a \u0645\u06a9\u0627\u0646\u06cc:","policy-narengi-general-subtitle6":"\u062c. \u0627\u0631\u062a\u0628\u0627\u0637\u0627\u062a:","policy-narengi-general-subtitle7":"\u0627\u0644\u0641. \u0627\u0631\u0627\u0626\u0647 \u0648 \u0628\u0647\u0628\u0648\u062f \u062e\u062f\u0645\u0627\u062a:","policy-narengi-general-subtitle8":"\u0628. \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0645\u0634\u062a\u0631\u06cc:","policy-narengi-general-subtitle9":"\u067e. \u0628\u0627\u0632\u0627\u0631\u06cc\u0627\u0628\u06cc \u0648 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a:","policy-narengi-general-title":"\u0645\u0627 \u0686\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0627\u0632 \u0634\u0645\u0627 \u0645\u06cc\u200c\u06af\u06cc\u0631\u06cc\u0645\u061f","policy-narengi-info-descr1":"\u0645\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627 \u0627\u0634\u062e\u0627\u0635 \u062b\u0627\u0644\u062b \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0646\u0645\u06cc\u200c\u06af\u0630\u0627\u0631\u06cc\u0645\u060c \u0645\u06af\u0631 \u062f\u0631 \u0634\u0631\u0627\u06cc\u0637 \u0632\u06cc\u0631:","policy-narengi-info-descr2":"\u0645\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u0631\u0627 \u0628\u0627 \u0627\u0631\u0627\u0626\u0647\u200c\u062f\u0647\u0646\u062f\u06af\u0627\u0646 \u062e\u062f\u0645\u0627\u062a \u0645\u0639\u062a\u0628\u0631\u06cc \u06a9\u0647 \u062f\u0631 \u0627\u0631\u0627\u0626\u0647 \u062e\u062f\u0645\u0627\u062a \u0646\u0627\u0631\u0646\u06af\u06cc \u0628\u0647 \u0645\u0627 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u0646\u062f\u060c \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0628\u06af\u0630\u0627\u0631\u06cc\u0645. \u0627\u06cc\u0646 \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9\u200c\u06af\u0630\u0627\u0631\u06cc \u0645\u0634\u0631\u0648\u0637 \u0631\u0639\u0627\u06cc\u062a \u062f\u0642\u06cc\u0642 \u0645\u062d\u0631\u0645\u0627\u0646\u06af\u06cc \u0648 \u0631\u0639\u0627\u06cc\u062a \u0627\u0645\u0646\u06cc\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627\u0633\u062a.","policy-narengi-info-descr3":"\u0645\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u062f\u0631 \u0635\u0648\u0631\u062a \u0646\u06cc\u0627\u0632 \u0642\u0627\u0646\u0648\u0646\u06cc\u060c \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0645\u0642\u0627\u0645\u0627\u062a \u062f\u0648\u0644\u062a\u06cc\u060c \u06cc\u0627 \u0628\u0631\u0627\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062d\u0642\u0648\u0642 \u0648 \u0645\u0646\u0627\u0641\u0639 \u062e\u0648\u062f\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u0631\u0627 \u0627\u0641\u0634\u0627 \u06a9\u0646\u06cc\u0645.","policy-narengi-info-descr4":"\u062f\u0631 \u0635\u0648\u0631\u062a \u0627\u062f\u063a\u0627\u0645\u060c \u062e\u0631\u06cc\u062f\u060c \u06cc\u0627 \u0641\u0631\u0648\u0634 \u06a9\u0644 \u06cc\u0627 \u0628\u062e\u0634\u06cc \u0627\u0632 \u062f\u0627\u0631\u0627\u06cc\u06cc\u200c\u0647\u0627\u06cc \u0633\u0631\u0648\u06cc\u0633 \u0646\u0627\u0631\u0646\u06af\u06cc\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0645\u0639\u0627\u0645\u0644\u0647 \u0645\u0646\u062a\u0642\u0644 \u0634\u0648\u062f.","policy-narengi-info-subtitle1":"\u0627\u0644\u0641. \u0627\u0631\u0627\u0626\u0647\u200c\u062f\u0647\u0646\u062f\u06af\u0627\u0646 \u062e\u062f\u0645\u0627\u062a:","policy-narengi-info-subtitle2":"\u0628. \u0627\u0644\u0632\u0627\u0645\u0627\u062a \u0642\u0627\u0646\u0648\u0646\u06cc:","policy-narengi-info-subtitle3":"\u062c. \u0627\u0646\u062a\u0642\u0627\u0644\u0627\u062a \u062a\u062c\u0627\u0631\u06cc:","policy-narengi-info-title":"\u0627\u0641\u0634\u0627\u06cc \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627","policy-narengi-security-descr":"\u0645\u0627 \u0628\u0631\u0627\u06cc \u0645\u062d\u0627\u0641\u0638\u062a \u0627\u0632 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u062f\u0631 \u0628\u0631\u0627\u0628\u0631 \u062f\u0633\u062a\u0631\u0633\u06cc\u060c \u0627\u0641\u0634\u0627\u060c \u062a\u063a\u06cc\u06cc\u0631 \u0648 \u062a\u062e\u0631\u06cc\u0628 \u063a\u06cc\u0631\u0645\u062c\u0627\u0632\u060c \u0627\u0632 \u062a\u062f\u0627\u0628\u06cc\u0631 \u0627\u0645\u0646\u06cc\u062a\u06cc \u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u062f \u0648 \u0631\u0627\u06cc\u062c \u062f\u0631 \u0627\u06cc\u0646 \u0635\u0646\u0639\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u0627\u0644\u0628\u062a\u0647 \u0628\u0627 \u0627\u06cc\u0646\u06a9\u0647 \u0645\u0627 \u062a\u0645\u0627\u0645 \u062a\u0644\u0627\u0634\u0645\u0627\u0646 \u0631\u0627 \u0628\u0631\u0627\u06cc \u0645\u062d\u0627\u0641\u0638\u062a \u0627\u0632 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645\u060c \u0647\u06cc\u0686 \u0633\u06cc\u0633\u062a\u0645\u06cc \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0627\u0645\u0646\u06cc\u062a \u06a9\u0627\u0645\u0644 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0631\u0627 \u062a\u0636\u0645\u06cc\u0646 \u06a9\u0646\u062f.","policy-narengi-security-title":"\u0627\u0645\u0646\u06cc\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u0645\u0627","policy-narengi-title":"\u0633\u06cc\u0627\u0633\u062a \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc","policy-text-1":"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062e\u062f\u0645\u0627\u062a \u0645\u0627 \u0628\u062f\u0648\u0646 \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0627\u0645\u06a9\u0627\u0646\u200c\u067e\u0630\u06cc\u0631 \u0627\u0633\u062a. \u062f\u0631\u200c\u0635\u0648\u0631\u062a \u062a\u0645\u0627\u06cc\u0644 \u0628\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627\u06cc \u062e\u0627\u0635 \u0634\u0631\u06a9\u062a \u0645\u0627\u060c \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0636\u0631\u0648\u0631\u06cc \u0628\u0627\u0634\u062f. \u062f\u0631 \u0634\u0631\u0627\u06cc\u0637\u06cc \u06a9\u0647 \u0627\u06cc\u0646 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0636\u0631\u0648\u0631\u062a \u06cc\u0627\u0628\u062f\u060c \u0648 \u0645\u0628\u0646\u0627\u06cc \u062d\u0642\u0648\u0642\u06cc \u0686\u0646\u06cc\u0646 \u0639\u0645\u0644\u06cc\u0627\u062a\u06cc \u0641\u0631\u0627\u0647\u0645 \u0646\u0628\u0627\u0634\u062f\u060c \u0645\u0627 \u0628\u0631\u0627\u06cc \u0627\u062e\u0630 \u0631\u0636\u0627\u06cc\u062a \u0627\u0632 \u0634\u0645\u0627 \u0627\u0642\u062f\u0627\u0645 \u062e\u0648\u0627\u0647\u06cc\u0645 \u06a9\u0631\u062f.","policy-text-10":"\xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb \u0628\u0647\u200c\u0645\u0639\u0646\u0627\u06cc \u0634\u062e\u0635 \u062d\u0642\u06cc\u0642\u06cc \u06cc\u0627 \u062d\u0642\u0648\u0642\u06cc\u060c \u0645\u0642\u0627\u0645 \u062f\u0648\u0644\u062a\u06cc\u060c \u0633\u0627\u0632\u0645\u0627\u0646 \u06cc\u0627 \u0633\u0627\u06cc\u0631 \u0646\u0647\u0627\u062f\u0647\u0627\u06cc\u06cc \u0627\u0633\u062a \u06a9\u0647\u060c \u0628\u0647\u200c\u062a\u0646\u0647\u0627\u06cc\u06cc \u06cc\u0627 \u0628\u0647\u200c\u0627\u062a\u0641\u0627\u0642 \u0633\u0627\u06cc\u0631\u06cc\u0646\u060c \u0627\u0647\u062f\u0627\u0641 \u0648 \u0648\u0633\u0627\u06cc\u0644 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0631\u0627 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u06a9\u0646\u062f\u061b \u062f\u0631\u200c\u062d\u0627\u0644\u06cc \u06a9\u0647 \u0627\u0647\u062f\u0627\u0641 \u0648 \u0648\u0633\u0627\u06cc\u0644 \u0686\u0646\u06cc\u0646 \u067e\u0631\u062f\u0627\u0632\u0634\u06cc \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0642\u0627\u0646\u0648\u0646 \u0627\u062a\u062d\u0627\u062f\u06cc\u0647 \u06cc\u0627 \u0647\u0631\u200c\u06cc\u06a9 \u0627\u0632 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0639\u0636\u0648 \u0622\u0646 \u062a\u0639\u06cc\u06cc\u0646 \u0645\u06cc\u200c\u0634\u0648\u062f\u060c \xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb \u06cc\u0627 \u0645\u0639\u06cc\u0627\u0631\u0647\u0627\u06cc \u062e\u0627\u0635 \u06af\u0632\u06cc\u0646\u0634 \u0648\u06cc \u0646\u06cc\u0632 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0642\u0627\u0646\u0648\u0646 \u0627\u062a\u062d\u0627\u062f\u06cc\u0647 \u06cc\u0627 \u06a9\u0634\u0648\u0631\u0647\u0627\u06cc \u0639\u0636\u0648 \u0622\u0646 \u0645\u0642\u0631\u0631 \u0634\u0648\u062f.","policy-text-11":"\xab\u0634\u062e\u0635 \u062b\u0627\u0644\u062b\xbb \u0628\u0647\u200c\u0645\u0639\u0646\u0627\u06cc \u0647\u0631 \u0634\u062e\u0635 \u062d\u0642\u06cc\u0642\u06cc \u06cc\u0627 \u062d\u0642\u0648\u0642\u06cc\u060c \u0645\u0642\u0627\u0645 \u062f\u0648\u0644\u062a\u06cc\u060c \u0633\u0627\u0632\u0645\u0627\u0646\u060c \u06cc\u0627 \u0646\u0647\u0627\u062f\u06cc \u063a\u06cc\u0631 \u0627\u0632 \xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb\u060c \xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb\u060c \xab\u067e\u0631\u062f\u0627\u0632\u0634\u06af\u0631\xbb\u060c \u0648 \u0627\u0641\u0631\u0627\u062f\u06cc \u0627\u0633\u062a \u06a9\u0647\u060c \u0628\u0647\u200c\u0645\u0648\u062c\u0628 \u0645\u062c\u0648\u0632 \u0645\u0633\u062a\u0642\u06cc\u0645 \xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb \u06cc\u0627 \xab\u067e\u0631\u062f\u0627\u0632\u0634\u06af\u0631\xbb\u060c \u0645\u062c\u0627\u0632 \u0628\u0647 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0628\u0627\u0634\u0646\u062f.","policy-text-12":"\xab\u0631\u0636\u0627\u06cc\u062a\xbb \xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb \u0628\u0647\u200c\u0645\u0639\u0646\u0627\u06cc \u0647\u0631\u200c\u06af\u0648\u0646\u0647 \u0646\u0634\u0627\u0646\u0647\u200c\u0627\u06cc \u0627\u0632 \u062a\u0645\u0627\u06cc\u0644\u0627\u062a \u0622\u0632\u0627\u062f\u0627\u0646\u0647\u060c \u0645\u0634\u062e\u0635\u060c \u0627\u0628\u0644\u0627\u063a\u200c\u0634\u062f\u0647\u060c \u0648 \u063a\u06cc\u0631\u0645\u0628\u0647\u0645 \xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb \u0627\u0633\u062a\u060c \u06a9\u0647 \u0628\u0647\u200c\u0645\u0648\u062c\u0628 \u0622\u0646\u060c \u0648\u06cc\u060c \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u0638\u0647\u0627\u0631 \u06cc\u0627 \u0627\u0642\u062f\u0627\u0645 \u0648\u0627\u0636\u062d \u0648 \u062a\u0627\u06a9\u06cc\u062f\u06cc\u060c \u062a\u0648\u0627\u0641\u0642 \u062e\u0648\u062f \u0628\u0627 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062e\u0648\u062f \u0631\u0627 \u0627\u0628\u0632\u0627\u0631 \u062f\u0627\u0631\u062f.","policy-text-13":"\u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u062a\u0646\u0647\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0634\u0631\u06a9\u062a \u0645\u0627 \u0648 \u0645\u0637\u0627\u0628\u0642 \u0628\u0627 \u0645\u0642\u0631\u0631\u0627\u062a \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647 \u0645\u0639\u062a\u0628\u0631 \u067e\u0631\u062f\u0627\u0632\u0634 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0645\u06a9\u0627\u062a\u0628\u0647 \u0634\u0645\u0627 \u0628\u0627 \u0634\u0631\u06a9\u062a \u0645\u0627\u060c \u06cc\u0627 \u062a\u06a9\u0645\u06cc\u0644 \u0641\u0631\u0645 \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u062e\u0648\u062f\u060c \u0628\u0647\u200c\u0645\u0639\u0646\u0627\u06cc \u0645\u0648\u0627\u0641\u0642\u062a \u0634\u0645\u0627 \u0628\u0627 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0628\u0631\u0627\u06cc \u0627\u0647\u062f\u0627\u0641 \u0645\u0630\u06a9\u0648\u0631 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.","policy-text-14":"\u0646\u0647\u0627\u062f \u0645\u0633\u0626\u0648\u0644 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc\u060c \u067e\u0631\u062f\u0627\u0632\u0634\u060c \u0648 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0637\u0628\u0642 \u0634\u0631\u0627\u06cc\u0637 \u0645\u0642\u0631\u0631 \u062f\u0631 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb \u0639\u0628\u0627\u0631\u062a\u0633\u062a \u0627\u0632:","policy-text-15":"\u0628\u0631\u0627\u06cc \u0637\u0631\u062d \u0633\u0626\u0648\u0627\u0644 \u062f\u0631 \u0632\u0645\u06cc\u0646\u0647 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u060c \u0644\u0637\u0641\u0627\u064b \u0628\u0647 \u0622\u062f\u0631\u0633 \u067e\u0633\u062a \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0632\u06cc\u0631 \u0645\u06a9\u0627\u062a\u0628\u0647 \u06a9\u0646\u06cc\u062f:","policy-text-16":" \u0645\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u0627\u0647\u062f\u0627\u0641 \u0645\u0630\u06a9\u0648\u0631 \u062f\u0631 \u0627\u06cc\u0646 \u0628\u06cc\u0627\u0646\u06cc\u0647 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u067e\u0631\u062f\u0627\u0632\u0634 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0634\u0645\u0627\u060c \u0628\u0647\u200c\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u0645\u0648\u0627\u0631\u062f \u0645\u0642\u0631\u0631 \u062f\u0631 \u0628\u06cc\u0627\u0646\u06cc\u0647 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647 \u067e\u06cc\u0634\u200c\u0631\u0648 \u06cc\u0627 \u0642\u0648\u0627\u0646\u06cc\u0646 \u0645\u0644\u06cc \u0648 \u0627\u0644\u0632\u0627\u0645\u200c\u0622\u0648\u0631\u060c \u062f\u0631\u200c\u0627\u062e\u062a\u06cc\u0627\u0631 \u0627\u0634\u062e\u0627\u0635 \u062b\u0627\u0644\u062b \u0642\u0631\u0627\u0631 \u062f\u0627\u062f\u0647 \u0646\u062e\u0648\u0627\u0647\u062f \u0634\u062f.","policy-text-17":" \u062f\u0631\u200c\u0635\u0648\u0631\u062a \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0627\u062a \u062e\u0627\u0635 \u062f\u0631 \u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u0627 - \u0627\u0632 \u0642\u0628\u06cc\u0644 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc\u060c \u062e\u0628\u0631\u0646\u0627\u0645\u0647\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062a\u0645\u0627\u0633- \u062b\u0628\u062a \u0646\u0627\u0645 \u0627\u0648\u0644\u06cc\u0647 \u0634\u0645\u0627 (\u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0627\u062a) \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0636\u0631\u0648\u0631\u06cc \u0628\u0627\u0634\u062f\u060c \u06a9\u0647 \u0627\u06cc\u0646 \u0627\u0645\u0631 \u067e\u0631\u062f\u0627\u0632\u0634 \u0645\u0642\u062a\u0636\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647\u200c\u062f\u0646\u0628\u0627\u0644 \u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a. \u062f\u0631 \u0647\u0631\u200c\u062d\u0627\u0644\u060c \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u0645\u0627 \u062a\u0646\u0647\u0627 \u0628\u0647\u200c\u0634\u0631\u0637\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u06a9\u0647 \u0634\u0645\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0634\u0631\u06a9\u062a \u0645\u0627 \u0627\u0631\u0633\u0627\u0644 \u06a9\u0631\u062f\u0647 \u0628\u0627\u0634\u06cc\u062f \u0648 \u0645\u0628\u0646\u0627\u06cc \u062d\u0642\u0648\u0642\u06cc \u0628\u0631\u0627\u06cc \u067e\u0631\u062f\u0627\u0632\u0634 \u0622\u0646\u0647\u0627 \u062f\u0631\u200c\u062f\u0633\u062a \u0628\u0627\u0634\u062f.","policy-text-18":"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u067e\u0644\u062a\u0641\u0631\u0645 \xab\u062a\u0644\u0648\u06cc\u06a9\u0627\xbb \u0648 \u0628\u0631\u200c\u0627\u0633\u0627\u0633 \u0622\u0646 \u0627\u0633\u062a\u0631\u06cc\u0645 \u06a9\u0631\u062f\u0646 \u0645\u062d\u062a\u0648\u0627\u06cc \u0648\u06cc\u062f\u0626\u0648\u06cc\u06cc \u0645\u0633\u062a\u0644\u0632\u0645 \u0628\u0631\u062e\u0648\u0631\u062f\u0627\u0631\u06cc \u0627\u0632 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0627\u0633\u062a. \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u062f\u0631 \u0647\u0631 \u0632\u0645\u0627\u0646 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062e\u0648\u062f \u0631\u0627 \u062d\u0630\u0641 \u06a9\u0646\u06cc\u062f. \u0628\u0631\u062e\u06cc \u0627\u0632 \u0633\u0631\u0648\u06cc\u0633\u200c\u0647\u0627\u06cc \u0627\u0631\u0627\u0626\u0647\u200c\u0634\u062f\u0647 \u0627\u0632 \u0633\u0648\u06cc \u0645\u0627 \u0646\u06cc\u0627\u0632\u0645\u0646\u062f \u062a\u0634\u0631\u06cc\u06a9 \u0645\u0633\u0627\u0639\u06cc \u0628\u0627 \u0634\u0631\u06a9\u062a\u200c\u0647\u0627\u06cc \u0647\u0645\u06a9\u0627\u0631 \u0627\u0633\u062a. \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u067e\u0644\u062a\u0641\u0631\u0645\u060c \u06a9\u0627\u0631\u0633\u0627\u0632\u06cc \u067e\u0631\u062f\u0627\u062e\u062a \u0636\u0631\u0648\u0631\u06cc \u0627\u0633\u062a\u060c \u06a9\u0647 \u0645\u0627 \u0627\u06cc\u0646 \u0641\u0631\u0622\u06cc\u0646\u062f \u0631\u0627 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u0631\u0627\u0626\u0647 \u062f\u0647\u0646\u062f\u0647 \u062e\u062f\u0645\u0627\u062a \u062e\u0648\u062f ]\u0646\u0627\u0645\u060c \u0622\u062f\u0631\u0633[ \u0628\u0647\u200c\u0627\u062c\u0631\u0627 \u0645\u06cc\u200c\u06af\u0630\u0627\u0631\u06cc\u0645. \u0647\u0631\u200c\u0686\u0646\u062f\u060c \u0627\u0631\u0627\u0626\u0647\u200c\u062f\u0647\u0646\u062f\u0647 \u062e\u062f\u0645\u0627\u062a \u0645\u0627 \u0645\u062c\u0627\u0632 \u0628\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0627\u0631\u0627\u0626\u0647\u200c\u0634\u062f\u0647 \u0628\u0631\u0627\u06cc \u0627\u0647\u062f\u0627\u0641\u06cc \u063a\u06cc\u0631 \u0627\u0632 \u0645\u0648\u0636\u0648\u0639\u0627\u062a \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u0633\u0631\u0648\u06cc\u0633 \u06cc\u0627\u062f\u200c\u0634\u062f\u0647 \u0646\u06cc\u0633\u062a.","policy-text-19":"\u0628\u0631\u0627\u06cc \u0627\u06cc\u062c\u0627\u062f \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u060c \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0632\u06cc\u0631 \u0636\u0631\u0648\u0631\u06cc \u0627\u0633\u062a: \u0646\u0627\u0645\u060c \u0622\u062f\u0631\u0633\u060c \u0648 \u0686\u0647\u0627\u0631 \u0631\u0642\u0645 \u0622\u062e\u0631 \u06a9\u0627\u0631\u062a \u0627\u0639\u062a\u0628\u0627\u0631\u06cc \u0634\u0645\u0627.","policy-text-2":"\u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0645\u0637\u0627\u0628\u0642 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 (GDPR)\xbb \u0648 \u0645\u0642\u0631\u0631\u0627\u062a \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647 \u062e\u0627\u0635 \u06a9\u0634\u0648\u0631 \u0645\u0631\u0628\u0648\u0637\u0647 \u0627\u0646\u062c\u0627\u0645 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0628\u0647\u200c\u0645\u0648\u062c\u0628 \xab\u0628\u06cc\u0627\u0646\u06cc\u0647 \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb \u062c\u0627\u0631\u06cc \u0634\u0631\u06a9\u062a \u0645\u0627 \u0645\u0627\u06cc\u0644 \u0627\u0633\u062a \u0646\u0648\u0639\u060c \u062f\u0627\u0645\u0646\u0647\u060c \u0648 \u0627\u0647\u062f\u0627\u0641 \u0645\u0631\u062a\u0628\u0637 \u0628\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc\u0650 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc\u200c\u060c \u0627\u0633\u062a\u0641\u0627\u062f\u0647\u060c \u0648 \u067e\u0631\u062f\u0627\u0632\u0634\u200c\u0634\u062f\u0647 \u0631\u0627 \u0628\u0647\u200c\u0627\u0637\u0644\u0627\u0639 \u0639\u0645\u0648\u0645 \u0628\u0631\u0633\u0627\u0646\u062f. \u0639\u0644\u0627\u0648\u0647\u200c\u0628\u0631 \u0622\u0646\u060c \u0645\u0627\u06cc\u0644\u06cc\u0645 \u062d\u0642\u0648\u0642 \u062e\u0627\u0635 \u0634\u0645\u0627 \u0631\u0627 \u0628\u0647 \u0627\u0637\u0644\u0627\u0639\u200c\u062a\u0627\u0646 \u0628\u0631\u0633\u0627\u0646\u06cc\u0645.","policy-text-20":"\u062f\u0631\u200c\u0637\u0648\u0644 \u062f\u0648\u0631\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u06cc\u062a \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f\u060c \u0628\u0627 \u0627\u0639\u0644\u0627\u0645 \u0631\u0636\u0627\u06cc\u062a \u0635\u0631\u06cc\u062d\u060c \u06cc\u0627 \u0627\u0631\u0627\u0626\u0647 \u0622\u062f\u0631\u0633 \u067e\u0633\u062a \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9 \u062e\u0648\u062f \u0628\u0647 \u0627\u06cc\u0646 \u0645\u0646\u0638\u0648\u0631\u060c \u0628\u0631\u0627\u06cc \u062f\u0633\u062a\u0631\u0633\u06cc \u0628\u0647 \u062e\u0628\u0631\u0646\u0627\u0645\u0647 \u062b\u0628\u062a \u0646\u0627\u0645 \u06a9\u0646\u06cc\u062f. \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc\u200c\u0634\u062f\u0647 \u0628\u0647\u200c\u0639\u0646\u0648\u0627\u0646 \u0628\u062e\u0634\u06cc \u0627\u0632 \u0641\u0631\u0622\u06cc\u0646\u062f \u062b\u0628\u062a \u0646\u0627\u0645 \u062e\u0628\u0631\u0646\u0627\u0645\u0647 \u062a\u0646\u0647\u0627 \u0628\u0631\u0627\u06cc \u0627\u0631\u0633\u0627\u0644 \u062e\u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0647\u200c\u06a9\u0627\u0631 \u06af\u0631\u0641\u062a\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u062e\u0628\u0631\u0646\u0627\u0645\u0647 \u062a\u0646\u0647\u0627 \u0628\u0647 \u0622\u062f\u0631\u0633 \u067e\u0633\u062a \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9 \u0627\u0639\u0644\u0627\u0645\u200c\u0634\u062f\u0647 \u0627\u0632 \u0633\u0648\u06cc \u0634\u0645\u0627 \u0627\u0631\u0633\u0627\u0644 \u0645\u06cc\u200c\u0634\u0648\u062f. \u0639\u0644\u0627\u0648\u0647\u200c\u0628\u0631 \u0622\u0646\u060c \u0627\u0632 \u0634\u0645\u0627 \u062a\u0642\u0627\u0636\u0627 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645 \u0645\u0627\u0644\u06a9\u06cc\u062a \u062e\u0648\u062f \u0628\u0631 \u0622\u062f\u0631\u0633 \u067e\u0633\u062a \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9 \u0627\u0639\u0644\u0627\u0645\u200c\u0634\u062f\u0647 \u0627\u0632 \u0633\u0648\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u0647\u200c\u0645\u062b\u0627\u0628\u0647 \u0645\u0648\u0627\u0641\u0642\u062a \u062e\u0648\u062f \u0628\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u062e\u0628\u0631\u0646\u0627\u0645\u0647 \u062a\u0627\u0626\u06cc\u062f \u06a9\u0646\u06cc\u062f.","policy-text-21":"\u062f\u0631\u200c\u0637\u0648\u0644 \u0645\u062f\u062a \u0627\u0634\u062a\u0631\u0627\u06a9 \u062e\u0628\u0631\u0646\u0627\u0645\u0647\u060c \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0645\u0646\u062f\u0631\u062c \u062f\u0631 \u0641\u06cc\u0644\u062f\u0647\u0627\u06cc \u062a\u0645\u0627\u0633(Contact Field) (\u0646\u0627\u0645\u060c \u0648 \u0622\u062f\u0631\u0633 \u067e\u0633\u062a \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9) \u0631\u0627 \u067e\u0631\u062f\u0627\u0632\u0634 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u0647\u062f\u0641 \u0627\u0632 \u0627\u06cc\u0646 \u0641\u0631\u0622\u06cc\u0646\u062f \u0627\u0637\u0644\u0627\u0639\u200c\u0631\u0633\u0627\u0646\u06cc \u062f\u0631\u200c\u0628\u0627\u0631\u0647 \u0641\u06cc\u0644\u0645\u200c\u0647\u0627 \u06cc\u0627 \u0633\u0631\u06cc\u0627\u0644\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0642\u0627\u0628\u0644 \u0639\u0631\u0636\u0647 \u062f\u0631 \u067e\u0644\u062a\u0641\u0631\u0645 \u0645\u0627 \u0627\u0633\u062a.","policy-text-22":"\u0645\u0628\u0646\u0627\u06cc \u062d\u0642\u0648\u0642\u06cc \u0627\u06cc\u0646 \u0641\u0631\u0622\u06cc\u0646\u062f \u06af\u0632\u0627\u0631\u0647 a \u067e\u0627\u0631\u0627\u06af\u0631\u0627\u0641 \u0627\u0648\u0644 \u0645\u0627\u062f\u0647 6 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb \u0627\u0633\u062a.","policy-text-23":"\u0634\u0645\u0627 \u0647\u0645\u0648\u0627\u0631\u0647 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0631\u0636\u0627\u06cc\u062a \u0642\u0628\u0644\u06cc \u062e\u0648\u062f \u0628\u0631\u0627\u06cc \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u067e\u0627\u0631\u0627\u06af\u0631\u0627\u0641 3 \u0645\u0627\u062f\u0647 7 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb \u0644\u063a\u0648 \u06a9\u0646\u06cc\u062f\u060c \u06a9\u0647 \u067e\u0633 \u0627\u0632 \u0627\u0638\u0647\u0627\u0631 \u0645\u062e\u0627\u0644\u0641\u062a \u0628\u0647\u200c\u0627\u062c\u0631\u0627 \u06af\u0630\u0627\u0631\u062f\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f. \u06a9\u0627\u0641\u06cc \u0627\u0633\u062a \u0627\u0642\u062f\u0627\u0645 \u0628\u0647 \u0627\u0644\u063a\u0627\u0621 \u0631\u0636\u0627\u06cc\u062a \u062e\u0648\u062f \u0631\u0627 \u0628\u0647 \u0645\u0627 \u0627\u0637\u0644\u0627\u0639 \u062f\u0647\u06cc\u062f\u060c \u06cc\u0627 \u0627\u0632 \xab\u0644\u06cc\u0646\u06a9 \u0641\u0633\u062e\xbb(Termination-Link) \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0647\u0631\u200c\u06cc\u06a9 \u0627\u0632 \u062e\u0628\u0631\u0646\u0627\u0645\u0647\u200c\u0647\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u06cc\u062f.","policy-text-24":"\u0648\u0628\u0633\u0627\u06cc\u062a \u0645\u0627 (www.televika.com) \u062d\u0627\u0648\u06cc \u0641\u0631\u0645 \u062a\u0645\u0627\u0633\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0622\u0646 \u0627\u0631\u062a\u0628\u0627\u0637 \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\u06cc \u0633\u0631\u06cc\u0639 \u0628\u0627 \u0634\u0631\u06a9\u062a \u0645\u0627\u060c \u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0645\u06a9\u0627\u062a\u0628\u0647 \u0645\u0633\u062a\u0642\u06cc\u0645 \u0628\u0627 \u0645\u0627 \u0627\u0645\u06a9\u0627\u0646\u200c\u067e\u0630\u06cc\u0631 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f\u060c \u0648 \u062f\u0631\u200c\u0639\u06cc\u0646 \u062d\u0627\u0644 \u0645\u062a\u0636\u0645\u0646 \u0622\u062f\u0631\u0633 \u06a9\u0644\u06cc \u067e\u0633\u062a\u06cc \u0645\u0627\u060c \u0645\u0648\u0633\u0648\u0645 \u0628\u0647 \xab\u067e\u0633\u062a \u0627\u0644\u06a9\u062a\u0631\u0648\u0646\u06cc\u06a9\xbb (\u0622\u062f\u0631\u0633 \u0627\u06cc\u0645\u06cc\u0644) \u0627\u0633\u062a. \u062f\u0631\u200c\u0635\u0648\u0631\u062a \u062a\u0645\u0627\u0633 \xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0641\u0631\u0645 \u062a\u0645\u0627\u0633 \u0628\u0627 \u0634\u0631\u06a9\u062a \u0645\u0627\u060c \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0627\u0631\u0633\u0627\u0644\u06cc \u0627\u0632 \u0633\u0648\u06cc \xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb \u0628\u0647\u200c\u0637\u0648\u0631 \u062e\u0648\u062f\u06a9\u0627\u0631 \u0630\u062e\u06cc\u0631\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.","policy-text-25":"\u0645\u0628\u0646\u0627\u06cc \u062d\u0642\u0648\u0642\u06cc \u0627\u06cc\u0646 \u0641\u0631\u0622\u06cc\u0646\u062f \u06af\u0632\u0627\u0631\u0647 b \u067e\u0627\u0631\u0627\u06af\u0631\u0627\u0641 \u0627\u0648\u0644 \u0645\u0627\u062f\u0647 6 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb \u0627\u0633\u062a.","policy-text-26":"\u062f\u0648\u0631\u0647 \u0632\u0645\u0627\u0646\u06cc \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc","policy-text-27":"\u0645\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0634\u0645\u0627 \u0631\u0627\u060c \u062d\u0633\u0628 \u0644\u0632\u0648\u0645\u060c \u0628\u0631\u0627\u06cc \u06a9\u0644 \u0645\u062f\u062a \u062f\u0648\u0627\u0645 \u0631\u0648\u0627\u0628\u0637 \u062a\u062c\u0627\u0631\u06cc \u0641\u06cc\u0645\u0627\u0628\u06cc\u0646 (\u0622\u063a\u0627\u0632 \u0641\u0631\u0622\u06cc\u0646\u062f\u060c \u0627\u0646\u062c\u0627\u0645 \u062a\u0631\u0627\u06a9\u0646\u0634\u060c \u0627\u062c\u0631\u0627\u06cc \u0642\u0631\u0627\u0631\u062f\u0627\u062f)\u060c \u0648 \u0639\u0644\u0627\u0648\u0647\u200c\u0628\u0631 \u0622\u0646\u060c \u0645\u0637\u0627\u0628\u0642 \u0628\u0627 \u062a\u0639\u0647\u062f\u0627\u062a \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u0648 \u0645\u0633\u062a\u0646\u062f\u0633\u0627\u0632\u06cc \u0646\u06af\u0647\u062f\u0627\u0631\u06cc \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u062f\u0648\u0631\u0647 \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u062a\u0627\u0628\u0639 \u0627\u0632 \u0627\u0644\u0632\u0627\u0645\u0627\u062a \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u0648 \u062f\u0648\u0631\u0647\u200c\u0647\u0627\u06cc \u0645\u062d\u062f\u0648\u062f\u06a9\u0646\u0646\u062f\u0647 \u0627\u0633\u062a.","policy-text-28":"\u062f\u0631 \u0631\u0627\u0628\u0637\u0647 \u0628\u0627 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u060c \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0648 \xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb\u200c\u0647\u0627 \u0627\u0632 \u062d\u0642\u0648\u0642 \u0632\u06cc\u0631 \u0628\u0631\u062e\u0648\u0631\u062f\u0627\u0631\u0646\u062f:","policy-text-29":"\u062f\u0631\u06cc\u0627\u0641\u062a \u062a\u0627\u0626\u06cc\u062f\u06cc\u0647 \u067e\u0631\u062f\u0627\u0632\u0634 \u06cc\u0627 \u0639\u062f\u0645\u200c\u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062e\u0648\u062f\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0631\u062a\u0628\u0637 \u0628\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0648\u0636\u0648\u0639 \u067e\u0631\u062f\u0627\u0632\u0634\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u06cc\u0634\u062a\u0631 \u062f\u0631\u0628\u0627\u0631\u0647 \u0645\u0627\u0647\u06cc\u062a \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u060c \u0648 \u0631\u0648\u0646\u0648\u0634\u062a\u200c\u0647\u0627\u06cc\u06cc \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 (\u0647\u0645\u0686\u0646\u06cc\u0646 \u0631\u062c\u0648\u0639 \u0634\u0648\u062f \u0628\u0647 \u0645\u0627\u062f\u0647 15 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb)\u061b","policy-text-3":"\u0645\u0627 \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u0641\u0646\u06cc \u0648 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0631\u0627 \u0628\u0631\u0627\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u0645\u0627 \u062f\u0631 \u0645\u0642\u0627\u0628\u0644 \u0641\u0642\u062f\u0627\u0646 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u060c \u0627\u06cc\u062c\u0627\u062f \u062a\u063a\u06cc\u06cc\u0631 \u06cc\u0627 \u062f\u0633\u062a\u0631\u0633\u06cc \u063a\u06cc\u0631\u200c\u0645\u062c\u0627\u0632 \u0627\u0646\u062c\u0627\u0645 \u062f\u0627\u062f\u0647\u200c\u0627\u06cc\u0645\u060c \u0648 \u0627\u06cc\u0646 \u0645\u0639\u06cc\u0627\u0631\u0647\u0627\u06cc \u0627\u0645\u0646\u06cc\u062a\u06cc \u0631\u0627 \u0645\u0637\u0627\u0628\u0642 \u0628\u0627 \u062a\u0648\u0633\u0639\u0647 \u0641\u0646\u0627\u0648\u0631\u06cc \u0628\u0647\u200c\u0637\u0648\u0631 \u0645\u0633\u062a\u0645\u0631 \u0628\u0647\u0628\u0648\u062f \u0645\u06cc\u200c\u062f\u0647\u06cc\u0645.","policy-text-30":"\u062a\u0635\u062d\u06cc\u062d \u06cc\u0627 \u062a\u06a9\u0645\u06cc\u0644 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0646\u0627\u062f\u0631\u0633\u062a \u06cc\u0627 \u0646\u0627\u0642\u0635 (\u0647\u0645\u0686\u0646\u06cc\u0646 \u0631\u062c\u0648\u0639 \u0634\u0648\u062f \u0628\u0647 \u0645\u0627\u062f\u0647 16 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb)\u061b","policy-text-31":"\u062d\u0630\u0641 \u0641\u0648\u0631\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062e\u0648\u062f (\u0647\u0645\u0686\u0646\u06cc\u0646 \u0631\u062c\u0648\u0639 \u0634\u0648\u062f \u0628\u0647 \u0645\u0627\u062f\u0647 17 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb)\u060c \u06cc\u0627 \u0627\u0632 \u0633\u0648\u06cc \u062f\u06cc\u06af\u0631\u060c \u062f\u0631\u200c\u0635\u0648\u0631\u062a \u0644\u0632\u0648\u0645 \u067e\u0631\u062f\u0627\u0632\u0634 \u0628\u06cc\u0634\u062a\u0631 \u0637\u0628\u0642 \u0645\u0641\u0627\u062f \u0645\u0635\u0631\u0651\u062d\u0647 \u062f\u0631 \u067e\u0627\u0631\u0627\u06af\u0631\u0627\u0641 3 \u0645\u0627\u062f\u0647 17 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb\u060c \u0645\u0645\u0627\u0646\u0639\u062a \u0627\u0632 \u067e\u0631\u062f\u0627\u0632\u0634 \u06cc\u0627\u062f\u200c\u0634\u062f\u0647 \u0637\u0628\u0642 \u0645\u0627\u062f\u0647 18 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb\u061b","policy-text-32":"\u062f\u0631\u06cc\u0627\u0641\u062a \u0631\u0648\u0646\u0648\u0634\u062a\u200c \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062e\u0648\u062f \u0648 \u06cc\u0627 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0627\u0631\u0627\u0626\u0647\u200c\u0634\u062f\u0647 \u0627\u0632 \u0633\u0648\u06cc \u062e\u0648\u062f\u060c \u0648 \u0627\u0631\u062c\u0627\u0639 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0627\u0631\u0633\u0627\u0644 \u0645\u0648\u0627\u0631\u062f \u06cc\u0627\u062f\u200c\u0634\u062f\u0647 \u0628\u0647 \u0633\u0627\u06cc\u0631 \u0627\u0631\u0627\u0626\u0647\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646/ \u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646 (\u0647\u0645\u0686\u0646\u06cc\u0646 \u0631\u062c\u0648\u0639 \u0634\u0648\u062f \u0628\u0647 \u0645\u0627\u062f\u0647 20 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb)\u061b","policy-text-33":"\u062b\u0628\u062a \u0634\u06a9\u0627\u06cc\u0627\u062a \u0646\u0632\u062f \u0645\u0631\u062c\u0639 \u0646\u0638\u0627\u0631\u062a\u06cc\u060c \u062f\u0631\u200c\u0635\u0648\u0631\u062a \u0627\u0639\u062a\u0642\u0627\u062f \u0628\u0647 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062e\u0648\u062f \u0627\u0632 \u0633\u0648\u06cc \xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb \u062f\u0631 \u062a\u062e\u0637\u06cc \u0627\u0632 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb (\u0647\u0645\u0686\u0646\u06cc\u0646 \u0631\u062c\u0648\u0639 \u0634\u0648\u062f \u0628\u0647 \u0645\u0627\u062f\u0647 77 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb).","policy-text-34":"\u0639\u0644\u0627\u0648\u0647\u200c\u0628\u0631 \u0622\u0646\u060c \u0637\u0628\u0642 \u0645\u0627\u062f\u0647 16\u060c \u067e\u0627\u0631\u0627\u06af\u0631\u0627\u0641 \u0646\u062e\u0633\u062a \u0645\u0627\u062f\u0647 17\u060c \u0648 \u0645\u0627\u062f\u0647 18 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb\u060c \xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb \u0645\u0648\u0638\u0641 \u0628\u0647 \u0627\u0637\u0644\u0627\u0639\u200c\u0631\u0633\u0627\u0646\u06cc \u0647\u0631\u200c\u06af\u0648\u0646\u0647 \u0627\u0635\u0644\u0627\u062d\u0627\u062a\u060c \u062d\u0630\u0641\u06cc\u0627\u062a\u060c \u06cc\u0627 \u0645\u062d\u062f\u0648\u062f\u06cc\u062a\u200c\u0647\u0627\u06cc \u0645\u0630\u06a9\u0648\u0631 \u0627\u0639\u0645\u0627\u0644\u200c\u0634\u062f\u0647 \u0628\u0631 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0628\u0647 \u06a9\u0644\u06cc\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a\u200c\u06a9\u0646\u0646\u062f\u06af\u0627\u0646\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0631\u0627 \u0646\u0632\u062f \u0627\u06cc\u0634\u0627\u0646 \u0641\u0627\u0634 \u0645\u06cc\u200c\u0633\u0627\u0632\u062f. \u0647\u0631\u200c\u0686\u0646\u062f\u060c \u0627\u06cc\u0646 \u0627\u0644\u0632\u0627\u0645 \u062f\u0631\u200c\u0635\u0648\u0631\u062a\u06cc \u06a9\u0647 \u0627\u0637\u0644\u0627\u0639\u200c\u0631\u0633\u0627\u0646\u06cc \u06cc\u0627\u062f\u200c\u0634\u062f\u0647\u060c \u0646\u0627\u0645\u0645\u06a9\u0646 \u0628\u0627\u0634\u062f \u06cc\u0627 \u062a\u0644\u0627\u0634\u06cc \u0646\u0627\u0645\u062a\u0646\u0627\u0633\u0628 \u0646\u06cc\u0627\u0632 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f\u060c \u0645\u0635\u062f\u0627\u0642 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a. \u0628\u0627 \u0627\u06cc\u0646\u200c\u0647\u0645\u0647\u060c \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0627\u0632 \u062d\u0642 \u062f\u0631\u06cc\u0627\u0641\u062a \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062f\u0631\u0628\u0627\u0631\u0647 \u06af\u06cc\u0631\u0646\u062f\u06af\u0627\u0646 \u06cc\u0627\u062f\u200c\u0634\u062f\u0647 \u0628\u0631\u062e\u0648\u0631\u062f\u0627\u0631 \u062e\u0648\u0627\u0647\u0646\u062f \u0628\u0648\u062f.","policy-text-35":"\u0628\u0647\u200c\u0637\u0648\u0631 \u0645\u0634\u0627\u0628\u0647\u060c \u0628\u0647\u200c\u0645\u0648\u062c\u0628 \u0645\u0627\u062f\u0647 21 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb\u060c \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0648 \xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb\u200c\u0647\u0627 \u0627\u0632 \u062d\u0642 \u0627\u0628\u0631\u0627\u0632 \u0645\u062e\u0627\u0644\u0641\u062a \u0628\u0627 \u067e\u0631\u062f\u0627\u0632\u0634 \u0622\u062a\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u062e\u0648\u062f \u0627\u0632 \u0633\u0648\u06cc \xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb\u060c \u0645\u0637\u0627\u0628\u0642 \u0628\u0627 \u06af\u0632\u0627\u0631\u0647 \u062c \u067e\u0627\u0631\u0627\u06af\u0631\u0627\u0641 \u0646\u062e\u0633\u062a \u0645\u0627\u062f\u0647 6 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb \u0628\u0631\u062e\u0648\u0631\u062f\u0627\u0631 \u062e\u0648\u0627\u0647\u0646\u062f \u0628\u0648\u062f. \u0645\u062e\u0627\u0644\u0641\u062a \u0628\u0627 \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 \u0628\u0627 \u0647\u062f\u0641 \u062a\u0628\u0644\u06cc\u063a\u0627\u062a \u0645\u0633\u062a\u0642\u06cc\u0645 \u0645\u062c\u0627\u0632 \u0627\u0633\u062a.","policy-text-36":"\u0627\u06cc\u0646 \u062d\u0642\u0648\u0642 \u062f\u0631 \u0647\u0631 \u0632\u0645\u0627\u0646\u060c \u0648 \u0628\u0627 \u0627\u0628\u0644\u0627\u063a \u06a9\u062a\u0628\u06cc \u0645\u0648\u0627\u0631\u062f \u0628\u0647 Ereele GmbH \u0642\u0627\u0628\u0644\u200c\u0627\u0633\u062a\u06cc\u0641\u0627\u0621 \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f. \u0644\u0637\u0641\u0627\u064b \u062a\u0648\u062c\u0647 \u0641\u0631\u0645\u0627\u0626\u06cc\u062f \u06a9\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u06cc\u0627\u062f\u200c\u0634\u062f\u0647 \u062a\u0646\u0647\u0627 \u062f\u0631\u200c\u0635\u0648\u0631\u062a \u0627\u0631\u0627\u0626\u0647 \u0645\u062f\u0627\u0631\u06a9 \u0647\u0648\u06cc\u062a\u06cc \u0645\u0631\u0628\u0648\u0637\u0647 \u0628\u0647 \u0634\u0645\u0627 \u0627\u0631\u0627\u0626\u0647 \u062e\u0648\u0627\u0647\u062f \u0634\u062f.","policy-text-37":"\u0645\u0627 \u0627\u0632 \u0633\u0631\u0648\u06cc\u0633 \u0645\u06cc\u06a9\u0633\u200c\u067e\u0646\u0644 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u062a\u062d\u0644\u06cc\u0644\u06af\u0631 \u062f\u06cc\u062a\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u06cc\u0646 \u0633\u0631\u0648\u06cc\u0633 \u0645\u0627 \u062f\u06cc\u062a\u0627 \u0631\u0627 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u0648 \u0645\u062f\u06cc\u0631\u06cc\u062a \u0645\u06cc\u200c\u06a9\u0646\u06cc\u0645. \u0627\u06cc\u0646 \u0633\u0631\u0648\u06cc\u0633 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u062a\u0627\u0645\u06cc\u0646\u200c\u06a9\u0646\u0646\u062f\u0647 \u0637\u0631\u0641 \u0627\u0648\u0644\u060c \u0627\u0645\u0646\u06cc\u062a \u062f\u06cc\u062a\u0627 \u0631\u0627 \u062a\u0627\u0645\u06cc\u0646 \u0645\u06cc\u200c\u06a9\u0646\u062f. \u0645\u06cc\u06a9\u0633\u200c\u067e\u0646\u0644 \u0627\u0647\u0645\u06cc\u062a \u0627\u0646\u062a\u0642\u0627\u0644 \u062f\u06cc\u062a\u0627 \u0634\u062e\u0635\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0631\u0627 \u062f\u0631 \u0633\u0637\u062d \u0628\u06cc\u0646\u200c\u0627\u0644\u0645\u0644\u0644\u06cc \u0645\u06cc\u200c\u062f\u0627\u0646\u062f. \u0628\u0631\u0646\u0627\u0645\u0647 \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u0645\u0627 \u0645\u0641\u0627\u062f \u0642\u0631\u0627\u0631\u062f\u0627\u062f\u06cc \u0627\u0633\u062a\u0627\u0646\u062f\u0627\u0631\u062f \u0631\u0627 \u0647\u0645\u0631\u0627\u0647 \u0628\u0627 \u0636\u0645\u0627\u0646\u062a \u0627\u0645\u0646\u06cc\u062a\u06cc \u0627\u062c\u0631\u0627 \u0645\u06cc\u200c\u06a9\u0646\u062f \u062a\u0627 \u0627\u0637\u0645\u06cc\u0646\u0627\u0646 \u062d\u0627\u0635\u0644 \u0634\u0648\u062f \u06a9\u0647 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc\u06cc \u06a9\u0647 \u0628\u0627 \u0645\u0627 \u0628\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0645\u06cc\u200c\u200c\u06af\u0630\u0627\u0631\u06cc\u062f \u0627\u0632 \u062d\u0645\u0627\u06cc\u062a\u200c\u0647\u0627\u06cc \u0642\u0627\u0646\u0648\u0646\u06cc \u0645\u0634\u0627\u0628\u0647 \u0628\u0627 \u0645\u0648\u0627\u0631\u062f \u0645\u0648\u062c\u0648\u062f \u062f\u0631 \u0627\u0631\u0648\u067e\u0627 \u0628\u0631\u062e\u0648\u0631\u062f\u0627\u0631 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u0628\u0631\u0646\u0627\u0645\u0647 Data Residency Program \u0633\u0631\u0648\u06cc\u0633 \u0645\u06cc\u06a9\u0633\u200c\u067e\u0646\u0644 \u0628\u0647 \u0645\u0627 \u0627\u0645\u06a9\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f \u062a\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u0631\u0627 \u062f\u0631 \u0645\u0631\u06a9\u0632 \u062f\u0627\u062f\u0647 \u0645\u0633\u062a\u0642\u0631 \u062f\u0631 \u06a9\u0634\u0648\u0631 \u0647\u0644\u0646\u062f \u067e\u0631\u062f\u0627\u0632\u0634 \u0648 \u0630\u062e\u06cc\u0631\u0647 \u06a9\u0646\u06cc\u0645. \u0645\u0637\u0627\u0628\u0642\u062a \u0628\u0627 \u0627\u06cc\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0628\u0647 \u0645\u06cc\u06a9\u0633\u200c\u067e\u0646\u0644 \u0627\u06cc\u0646 \u0627\u0645\u06a9\u0627\u0646 \u0631\u0627 \u0645\u06cc\u200c\u062f\u0647\u062f \u06a9\u0647 \u0645\u0646\u0637\u0628\u0642 \u0628\u0631 GDPR \u062e\u062f\u0645\u0627\u062a \u0627\u0631\u0627\u0626\u0647 \u0646\u0645\u0627\u06cc\u062f.","policy-text-38":"\u0622\u062e\u0631\u06cc\u0646 \u0631\u0648\u0632\u200c\u0631\u0633\u0627\u0646\u06cc: \u0698\u0627\u0646\u0648\u06cc\u0647 2023","policy-text-4":"\u0645\u0642\u0631\u0631\u0627\u062a \u0632\u06cc\u0631 \u0628\u0647\u200c\u0645\u0646\u0638\u0648\u0631 \u0627\u0631\u0627\u0626\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u062f\u0631\u0628\u0627\u0631\u0647 \u0634\u06cc\u0648\u0647\u060c \u062f\u0627\u0645\u0646\u0647\u060c \u0648 \u0627\u0647\u062f\u0627\u0641 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc\u060c \u0627\u0633\u062a\u0641\u0627\u062f\u0647\u060c \u0648 \u067e\u0631\u062f\u0627\u0632\u0634 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0641\u0631\u062f\u06cc \u0627\u0632 \u0633\u0648\u06cc \u060c \u0628\u0647\u200c\u0627\u0633\u062a\u062b\u0646\u0627\u06cc \u0648\u0628\u0633\u0627\u06cc\u062a \u0647\u0627\u06cc \u062a\u062d\u062a \u06a9\u0646\u062a\u0631\u0644 \u06cc\u0627 \u0627\u062f\u0627\u0631\u0647 \u0627\u0634\u062e\u0627\u0635 \u062b\u0627\u0644\u062b\u060c \u06a9\u0627\u0631\u0628\u0631\u062f \u0645\u06cc\u200c\u06cc\u0627\u0628\u0646\u062f. \u0644\u0637\u0641\u0627\u064b \u0645\u0633\u062a\u062d\u0636\u0631 \u0628\u0627\u0634\u06cc\u062f \u06a9\u0647 \u0645\u0627 \u062f\u0631\u200c\u0642\u0628\u0627\u0644 \u0645\u062d\u062a\u0648\u0627\u06cc \u062e\u062f\u0645\u0627\u062a\u060c \u0648\u0628\u0633\u0627\u06cc\u062a \u0647\u0627\u060c \u06cc\u0627 \u0648\u0638\u0627\u06cc\u0641 \u0627\u0634\u062e\u0627\u0635 \u062b\u0627\u0644\u062b \u0645\u0633\u0626\u0648\u0644 \u0646\u06cc\u0633\u062a\u06cc\u0645 \u0648 \u0646\u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u0645 \u0628\u0631 \u0622\u0646 \u062a\u0627\u062b\u06cc\u0631\u200c\u06af\u0630\u0627\u0631 \u0628\u0627\u0634\u06cc\u0645.","policy-text-5":"\u062f\u0631\u06cc\u0627\u0641\u062a \u062a\u0627\u0626\u06cc\u062f\u06cc\u0647 \u067e\u0631\u062f\u0627\u0632\u0634 \u06cc\u0627 \u0639\u062f\u0645\u200c\u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u062e\u0648\u062f\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0631\u062a\u0628\u0637 \u0628\u0627 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0645\u0648\u0636\u0648\u0639 \u067e\u0631\u062f\u0627\u0632\u0634\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u06cc\u0634\u062a\u0631 \u062f\u0631\u0628\u0627\u0631\u0647 \u0645\u0627\u0647\u06cc\u062a \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u060c \u0648 \u0631\u0648\u0646\u0648\u0634\u062a\u200c\u0647\u0627\u06cc\u06cc \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627 (\u0647\u0645\u0686\u0646\u06cc\u0646 \u0631\u062c\u0648\u0639 \u0634\u0648\u062f \u0628\u0647 \u0645\u0627\u062f\u0647 15 \xab\u0645\u0642\u0631\u0631\u0627\u062a \u0639\u0645\u0648\u0645\u06cc \u062d\u0641\u0627\u0638\u062a \u0627\u0632 \u062f\u0627\u062f\u0647\xbb)\u061b","policy-text-6":"\xab\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u0642\u0627\u0628\u0644\u200c\u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0645\u0646\u062d\u0635\u0631\u0627\u064b \u063a\u06cc\u0631\u200c\u0645\u0633\u062a\u0642\u06cc\u0645\xbb \u062f\u0627\u062f\u0647\u200c\u0627\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0622\u0646\u060c \u0645\u0634\u062a\u0631\u06cc\u0627\u0646\u060c \u0627\u0631\u0627\u0626\u0647\u200c\u062f\u0647\u0646\u062f\u06af\u0627\u0646 \u062e\u062f\u0645\u0627\u062a\u060c \u06cc\u0627 \u0645\u062e\u0627\u0637\u0628\u0627\u0646 \u0633\u0631\u0648\u06cc\u0633 \u0627\u0631\u062a\u0628\u0627\u0637\u06cc \u0646\u062a\u0648\u0627\u0646\u0646\u062f \u0647\u0648\u06cc\u062a \u0641\u0631\u062f\u06cc \u062e\u0627\u0635 \u0631\u0627 \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06cc \u0645\u062c\u0627\u0632 \u0642\u0627\u0646\u0648\u0646\u06cc \u062a\u0639\u06cc\u06cc\u0646 \u06a9\u0646\u0646\u062f.","policy-text-7":"\xab\u0627\u0637\u0644\u0627\u0639\u0627\u062a \u063a\u06cc\u0631\u200c\u0634\u062e\u0635\u06cc\xbb \u062f\u0627\u062f\u0647\u200c\u0627\u06cc \u0627\u0633\u062a \u06a9\u0647 \xab\u06af\u0645\u0646\u0627\u0645\u200c\u0633\u0627\u0632\u06cc\xbb \u0634\u062f\u0647 \u0627\u0633\u062a\u060c \u0648 \u062f\u0631 \u0647\u06cc\u0686 \u0634\u0631\u0627\u06cc\u0637\u06cc\u060c \u0642\u0627\u0628\u0644 \u0627\u0646\u062a\u0633\u0627\u0628 \u0628\u0647 \u0641\u0631\u062f\u06cc \u062e\u0627\u0635 \u0646\u06cc\u0633\u062a \u0648\u060c \u0627\u0632 \u0627\u06cc\u0646 \u0631\u0648\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0627\u0633\u062a \u06a9\u0647 \u0645\u0634\u0645\u0648\u0644 \u0633\u06cc\u0627\u0633\u062a \u062d\u0641\u0638 \u062d\u0631\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc \u062d\u0627\u06a9\u0645 \u0628\u0631 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0646\u06cc\u0633\u062a.","policy-text-8":"\xab\u0645\u0648\u0636\u0648\u0639 \u062f\u0627\u062f\u0647\xbb \u0628\u0647\u200c\u0645\u0639\u0646\u0627\u06cc \u0641\u0631\u062f \u062d\u0642\u06cc\u0642\u06cc \u0642\u0627\u0628\u0644 \u0634\u0646\u0627\u0633\u0627\u06cc\u06cc \u0627\u0633\u062a \u06a9\u0647 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0641\u0631\u062f\u06cc \u0648\u06cc \u0627\u0632 \u0633\u0648\u06cc \xab\u06a9\u0646\u062a\u0631\u0644\u200c\u06a9\u0646\u0646\u062f\u0647\xbb \u067e\u0631\u062f\u0627\u0632\u0634 \u0634\u062f\u0647 \u0627\u0633\u062a.","policy-text-9":"\xab\u067e\u0631\u062f\u0627\u0632\u0634\xbb \u0628\u0647\u200c\u0645\u0639\u0646\u0627\u06cc \u0647\u0631\u200c\u06af\u0648\u0646\u0647 \u0639\u0645\u0644\u06cc\u0627\u062a\u060c \u06cc\u0627 \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0627\u0632 \u0639\u0645\u0644\u06cc\u0627\u062a\u060c \u0647\u0645\u0686\u0648\u0646 \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc\u060c \u0636\u0628\u0637\u060c \u0633\u0627\u0632\u0645\u0627\u0646\u062f\u0647\u06cc\u060c \u0633\u0627\u062e\u062a\u0627\u0631\u0628\u0646\u062f\u06cc\u060c \u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc\u060c \u062a\u0637\u0628\u06cc\u0642 \u06cc\u0627 \u0627\u0639\u0645\u0627\u0644 \u062a\u063a\u06cc\u06cc\u0631\u0627\u062a\u060c \u0628\u0627\u0632\u06cc\u0627\u0628\u06cc\u060c \u0645\u0634\u0627\u0648\u0631\u0647\u060c \u0628\u0647\u0631\u0647\u200c\u0628\u0631\u062f\u0627\u0631\u06cc\u060c \u0627\u0641\u0634\u0627\u0621 \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u0646\u062a\u0642\u0627\u0644\u060c \u0627\u0646\u062a\u0634\u0627\u0631 \u06cc\u0627 \u0627\u0639\u0637\u0627\u06cc \u062f\u0633\u062a\u0631\u0633\u06cc \u0627\u0632 \u0637\u0631\u06cc\u0642\u06cc \u063a\u06cc\u0631 \u0622\u0646\u060c \u062a\u0646\u0638\u06cc\u0645 \u06cc\u0627 \u062a\u0631\u06a9\u06cc\u0628\u060c \u0645\u062d\u062f\u0648\u062f\u200c\u0633\u0627\u0632\u06cc\u060c \u0627\u0645\u062d\u0627\u0621 \u06cc\u0627 \u0627\u0646\u0647\u062f\u0627\u0645 \u0627\u0633\u062a\u060c \u06a9\u0647 \u0628\u0631\u200c\u0631\u0648\u06cc \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc \u06cc\u0627 \u0645\u062c\u0645\u0648\u0639\u0647\u200c\u0627\u06cc \u0627\u0632 \u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0634\u062e\u0635\u06cc\u060c \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u0628\u0632\u0627\u0631\u0647\u0627\u06cc \u062e\u0648\u062f\u06a9\u0627\u0631 \u06cc\u0627 \u063a\u06cc\u0631 \u0622\u0646 \u0627\u062c\u0631\u0627 \u0645\u06cc\u200c\u0634\u0648\u062f.","popular_in_filimo":"\u0645\u062d\u0628\u0648\u0628 \u062a\u0631\u06cc\u0646 \u0647\u0627\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648","prev":"\u0642\u0628\u0644\u06cc","prev_movie":"\u0641\u06cc\u0644\u0645 \u0642\u0628\u0644\u06cc","preview":"\u067e\u06cc\u0634 \u0646\u0645\u0627\u06cc\u0634","preview.section":"\u067e\u06cc\u0634 \u0646\u0645\u0627\u06cc\u0634 \u0648 \u0639\u06a9\u0633\u0647\u0627","product\u0640introduction":"\u0645\u0639\u0631\u0641\u06cc \u0645\u062d\u0635\u0648\u0644","profile_title":"\u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc","profile.active":"\u0641\u0639\u0627\u0644","profile.managment":"\u0645\u062f\u06cc\u0631\u06cc\u062a \u0627\u0639\u0636\u0627","promotion_televika.btn":"\u06af\u0634\u062a\u200c\u0648\u06af\u0630\u0627\u0631 \u062f\u0631 \u062a\u0644\u0648\u06cc\u06a9\u0627","promotion_televika.description1":"\u0628\u06cc\u0646\u0646\u062f\u06af\u0627\u0646 \u0641\u06