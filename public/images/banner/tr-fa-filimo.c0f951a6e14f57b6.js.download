7 \u0641\u06cc\u0644\u06cc\u0645\u0648","b2b.box-text1":"\u0627\u0632 \u0622\u0646\u062c\u0627\u06cc\u06cc \u06a9\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u0634\u0628\u06a9\u0647 \u0633\u0631\u06af\u0631\u0645\u06cc \u0648 \u067e\u062e\u0634 \u0641\u06cc\u0644\u0645 \u0648 \u0633\u0631\u06cc\u0627\u0644 \u062e\u0627\u0646\u06af\u06cc \u062c\u0627\u06cc \u062e\u0648\u062f \u0631\u0627 \u0628\u06cc\u0646 \u062e\u0627\u0646\u0648\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0627\u06cc\u0631\u0627\u0646\u06cc \u0628\u0627\u0632 \u06a9\u0631\u062f\u0647 \u0627\u0633\u062a\u060c \u0627\u0634\u062a\u0631\u0627\u06a9 \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u06cc\u06a9 \u0647\u062f\u06cc\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0645\u0646\u0627\u0633\u0628 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u0633\u0627\u0632\u0645\u0627\u0646 \u06cc\u0627 \u0634\u0631\u06a9\u062a \u0634\u0645\u0627 \u0628\u0627\u0634\u062f. \u0634\u0645\u0627 \u0628\u0627 \u0627\u06cc\u0646 \u062e\u0631\u06cc\u062f \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0628\u0631\u0627\u06cc \u0645\u0646\u0627\u0633\u0628\u062a\u200c\u0647\u0627 \u06cc\u0627 \u0642\u062f\u0631\u062f\u0627\u0646\u06cc \u0627\u0632 \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646\u060c \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u062f\u0648\u0646 \u062e\u0631\u06cc\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0631\u0627 \u0628\u0647 \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u062e\u0648\u062f \u0647\u062f\u06cc\u0647 \u0645\u06cc\u200c\u062f\u0647\u06cc\u062f \u0648 \u0647\u0645\u0647 \u0627\u0639\u0636\u0627\u06cc \u062e\u0627\u0646\u0648\u0627\u062f\u0647 \u0622\u0646\u200c\u0647\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0627 \u0627\u06cc\u0646 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u0632 \u0627\u06cc\u0646 \u0634\u0628\u06a9\u0647 \u062e\u0627\u0646\u06af\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u0646\u062f.","b2b.box-text2":" \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u06cc\u06a9 \u0647\u062f\u06cc\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0645\u0646\u0627\u0633\u0628 \u0628\u0631\u0627\u06cc \u0642\u062f\u0631\u062f\u0627\u0646\u06cc \u0627\u0632 \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u0648 \u0647\u0645\u06a9\u0627\u0631\u0627\u0646 \u0634\u0645\u0627 \u0627\u0633\u062a \u06a9\u0647 \u062f\u0633\u062a\u0631\u0633\u06cc \u062a\u0645\u0627\u0634\u0627\u06cc \u0628\u06cc\u0634 \u0627\u0632 \u06f1\u06f2\u06f0 \u0647\u0632\u0627\u0631 \u0641\u06cc\u0644\u0645 \u0648 \u0633\u0631\u06cc\u0627\u0644 \u0627\u06cc\u0631\u0627\u0646\u06cc \u0648 \u062e\u0627\u0631\u062c\u06cc \u0631\u0627 \u062f\u0631 \u0698\u0627\u0646\u0631\u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641\u060c \u0628\u062f\u0648\u0646 \u0646\u06cc\u0627\u0632 \u0628\u0647 \u062e\u0631\u06cc\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0647 \u0622\u0646\u200c\u0647\u0627 \u0648 \u0627\u0639\u0636\u0627\u06cc \u062e\u0627\u0646\u0648\u0627\u062f\u0647\u200c\u0634\u0627\u0646 \u0645\u06cc\u200c\u062f\u0647\u062f.","b2b.box-text3":"\u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u0634\u0645\u0627 \u0628\u0627 \u06cc\u06a9 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0627 \u0633\u0647 \u0639\u0636\u0648\u06cc\u062a \u062c\u062f\u0627\u06af\u0627\u0646\u0647 \u062f\u0631 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0641\u06cc\u0644\u0645 \u0648 \u0633\u0631\u06cc\u0627\u0644 \u062a\u0645\u0627\u0634\u0627 \u06a9\u0646\u0646\u062f \u0648 \u0647\u0645\u0686\u0646\u06cc\u0646 \u0628\u0631\u0627\u06cc \u06a9\u0648\u062f\u06a9 \u062e\u0648\u062f \u0639\u0636\u0648\u06cc\u062a \u06a9\u0648\u062f\u06a9 \u0628\u0633\u0627\u0632\u0646\u062f \u062a\u0627 \u0645\u062d\u062a\u0648\u0627\u06cc \u0645\u0646\u0627\u0633\u0628 \u0633\u0646 \u062e\u0648\u062f\u0634 \u0631\u0627 \u0628\u0628\u06cc\u0646\u062f. ","b2b.box-text4":"\u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u06f2\u06f4 \u0633\u0627\u0639\u062a\u0647 \u0648 \u06f7 \u0631\u0648\u0632 \u0647\u0641\u062a\u0647 \u0628\u0631\u0627\u06cc \u0631\u0627\u0647\u0646\u0645\u0627\u06cc\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0627\u0633\u062a. \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0627 \u0645\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u0646\u062d\u0648\u0647 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0641\u06cc\u0644\u06cc\u0645\u0648\u060c \u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc \u0627\u0634\u062a\u0631\u0627\u06a9 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0641\u06cc\u0644\u06cc\u0645\u0648\u060c \u062a\u0645\u0627\u0634\u0627\u06cc \u0641\u06cc\u0644\u0645 \u0648 \u0633\u0631\u06cc\u0627\u0644 \u062f\u0631 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0648\u2026 \u062a\u0645\u0627\u0633 \u0628\u06af\u06cc\u0631\u0646\u062f.","b2b.box-text5":"\u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u062a\u0648\u062c\u0647 \u0628\u0647 \u062a\u0639\u062f\u0627\u062f \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u0633\u0627\u0632\u0645\u0627\u0646 \u062e\u0648\u062f \u0648 \u0628\u0648\u062f\u062c\u0647\u200c\u0627\u06cc \u06a9\u0647 \u0628\u0631\u0627\u06cc \u062e\u0631\u06cc\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u062f\u0631 \u0646\u0638\u0631 \u06af\u0631\u0641\u062a\u06cc\u062f\u060c \u0627\u0632 \u0628\u06cc\u0646 \u0627\u0646\u0648\u0627\u0639 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u06af\u0632\u06cc\u0646\u0647 \u0645\u0646\u0627\u0633\u0628 \u062e\u0648\u062f \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0646\u06cc\u062f:","b2b.box-text6":"\u0628\u0631\u0627\u06cc \u062e\u0631\u06cc\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648\u060c \u067e\u0633 \u0627\u0632 \u0627\u0646\u062a\u062e\u0627\u0628 \u0646\u0648\u0639 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0641\u0631\u0645 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 \u06a9\u0647 \u0628\u0627\u0644\u0627\u06cc \u0647\u0645\u06cc\u0646 \u0635\u0641\u062d\u0647 \u0645\u06cc\u200c\u0628\u06cc\u0646\u06cc\u062f \u0631\u0627 \u062a\u06a9\u0645\u06cc\u0644 \u0648 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u062e\u0648\u062f \u0631\u0627 \u062b\u0628\u062a \u06a9\u0646\u06cc\u062f.","b2b.box-text7":"\u0633\u067e\u0633 \u0645\u0627 \u0627\u0632 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0627 \u0634\u0645\u0627 \u062a\u0645\u0627\u0633 \u0645\u06cc\u200c\u06af\u06cc\u0631\u06cc\u0645 \u062a\u0627 \u0633\u0641\u0627\u0631\u0634 \u0634\u0645\u0627 \u0631\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a \u0648 \u062b\u0628\u062a \u06a9\u0646\u06cc\u0645. \u0628\u0633\u062a\u0647 \u0628\u0647 \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u0634\u0645\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u0645 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0631\u0627\u060c \u0647\u0645 \u0628\u0647 \u0635\u0648\u0631\u062a \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 (\u0641\u06cc\u0632\u06cc\u06a9\u06cc) \u0648 \u0647\u0645 \u0628\u0647 \u0635\u0648\u0631\u062a \u0643\u062f \u062a\u062e\u0641\u064a\u0641 \u0641\u064a\u0644\u064a\u0645\u0648 (\u06a9\u062f \u062a\u062e\u0641\u06cc\u0641 \u06f1\u06f0\u06f0 \u062f\u0631\u0635\u062f \u0641\u06cc\u0644\u06cc\u0645\u0648) \u0628\u0631\u0627\u06cc \u0634\u0645\u0627 \u0628\u0641\u0631\u0633\u062a\u06cc\u0645.","b2b.box-text8":"\u067e\u0633 \u0627\u0632 \u0627\u0631\u0633\u0627\u0644 \u06a9\u062f \u062a\u062e\u0641\u06cc\u0641 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u06cc\u0627 \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u0648 \u0647\u0645\u06a9\u0627\u0631\u0627\u0646\u060c \u0644\u0627\u0632\u0645 \u0627\u0633\u062a \u0648\u0627\u0631\u062f \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0634\u0648\u0646\u062f \u0648 \u06cc\u06a9 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0628\u0633\u0627\u0632\u0646\u062f. \u0628\u0631\u0627\u06cc \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u06a9\u062f \u062a\u062e\u0641\u06cc\u0641 \u06a9\u0627\u0641\u06cc\u0633\u062a \u0648\u0627\u0631\u062f \u0635\u0641\u062d\u0647 \u062e\u0631\u06cc\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0634\u0648\u0646\u062f \u0648 \u06a9\u062f \u062a\u062e\u0641\u06cc\u0641\u06cc \u06a9\u0647 \u0628\u0647 \u0635\u0648\u0631\u062a \u062a\u0631\u06a9\u06cc\u0628\u06cc \u0627\u0632 \u062d\u0631\u0648\u0641 \u0648 \u0627\u0639\u062f\u0627\u062f \u0628\u0631\u0627\u06cc \u0622\u0646\u200c\u0647\u0627 \u0641\u0631\u0633\u062a\u0627\u062f\u0647 \u0634\u062f\u0647 \u06cc\u0627 \u0631\u0648\u06cc \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0646\u0648\u0634\u062a\u0647 \u0634\u062f\u0647 \u0631\u0627 \u062f\u0631 \u067e\u0627\u06cc\u06cc\u0646 \u0635\u0641\u062d\u0647 \u0648 \u062f\u0631 \u06a9\u0627\u062f\u0631 \u06a9\u062f \u062a\u062e\u0641\u06cc\u0641 \u0627\u0639\u0645\u0627\u0644 \u06a9\u0646\u0646\u062f \u062a\u0627 \u0627\u0634\u062a\u0631\u0627\u06a9 \u06f1\u060c \u06f3\u060c \u06f6 \u0645\u0627\u0647\u0647 \u06cc\u0627 \u06cc\u06a9\u200c\u0633\u0627\u0644\u0647 \u0628\u062f\u0648\u0646 \u067e\u0631\u062f\u0627\u062e\u062a \u0647\u06cc\u0686 \u0647\u0632\u06cc\u0646\u0647\u200c\u0627\u06cc \u0628\u0631\u0627\u06cc \u0622\u0646\u200c\u0647\u0627 \u0641\u0639\u0627\u0644 \u0634\u0648\u062f.","b2b.box-text9":"\u062f\u0631 \u0635\u0648\u0631\u062a \u0645\u062e\u062f\u0648\u0634 \u0628\u0648\u062f\u0646 \u06a9\u062f \u062a\u062e\u0641\u06cc\u0641 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u06a9\u0647 \u0631\u0648\u06cc \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u062f\u0631\u062c \u0634\u062f\u0647\u060c \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u062a\u0635\u0648\u06cc\u0631 \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0631\u0627 \u0628\u0631\u0627\u06cc \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 \u062f\u0631 \u062a\u0644\u06af\u0631\u0627\u0645 (@filimo_support) \u0628\u0641\u0631\u0633\u062a\u0646\u062f. \u062a\u06cc\u0645 \u067e\u0634\u062a\u06cc\u0628\u0627\u0646\u06cc \u067e\u0633 \u0627\u0632 \u0628\u0631\u0631\u0633\u06cc \u0634\u0645\u0627\u0631\u0647 \u0633\u0631\u06cc\u0627\u0644 \u0648 \u0627\u0639\u062a\u0628\u0627\u0631 \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647\u060c \u06cc\u06a9 \u06a9\u062f \u062c\u062f\u06cc\u062f \u0628\u0631\u0627\u06cc\u0634\u0627\u0646 \u0627\u0631\u0633\u0627\u0644 \u0645\u06cc\u200c\u06a9\u0646\u062f \u0648 \u0622\u0646\u200c\u0647\u0627 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0627\u0632 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u06a9\u0646\u0646\u062f.","b2b.box-yalda-text1":"\u0641\u06a9\u0631 \u0645\u06cc\u200c\u06a9\u0646\u06cc\u062f \u0686\u0647 \u0647\u062f\u06cc\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u062f \u067e\u06a9\u200c\u0647\u0627\u06cc \u06cc\u0644\u062f\u0627 \u0648 \u0646\u0648\u0631\u0648\u0632 \u0634\u0645\u0627 \u0631\u0627 \u062a\u06a9\u0645\u06cc\u0644 \u06a9\u0646\u062f\u061f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0641\u06cc\u0644\u06cc\u0645\u0648\u060c \u0628\u0647\u062a\u0631\u06cc\u0646 \u0648 \u062e\u0644\u0627\u0642\u0627\u0646\u0647\u200c\u062a\u0631\u06cc\u0646 \u0627\u0646\u062a\u062e\u0627\u0628 \u0628\u0631\u0627\u06cc \u0647\u062f\u0627\u06cc\u0627\u06cc \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0645\u0646\u0627\u0633\u0628\u062a\u06cc \u0627\u0633\u062a.","b2b.box-yalda-text2":"\u0627\u0634\u062a\u0631\u0627\u06a9\u200c\u0647\u0627\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u0646\u062f \u0628\u0647 \u0639\u0646\u0648\u0627\u0646 \u06cc\u06a9 \u0631\u0627\u0647\u06a9\u0627\u0631 \u062c\u0630\u0627\u0628 \u062f\u0631 \u062a\u0645\u0627\u0645 \u0645\u0646\u0627\u0633\u0628\u062a\u200c\u0647\u0627 \u0628\u0647 \u06a9\u0627\u0631 \u0631\u0648\u0646\u062f\u061b \u0627\u0632 \u062a\u0628\u0631\u06cc\u06a9 \u0639\u06cc\u062f \u0646\u0648\u0631\u0648\u0632 \u0628\u0647 \u06a9\u0627\u0631\u06a9\u0646\u0627\u0646 \u06af\u0631\u0641\u062a\u0647 \u062a\u0627 \u06af\u0631\u0645\u0627\u0628\u062e\u0634\u06cc \u0634\u0628 \u06cc\u0644\u062f\u0627 \u0628\u0647 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 . \u0647\u0645\u0686\u0646\u06cc\u0646 \u0627\u06cc\u0646 \u0647\u062f\u06cc\u0647\u060c \u0627\u0646\u062a\u062e\u0627\u0628\u06cc \u0627\u06cc\u062f\u0647\u200c\u0622\u0644 \u0628\u0631\u0627\u06cc \u062c\u0648\u0627\u06cc\u0632 \u0645\u0633\u0627\u0628\u0642\u0627\u062a\u060c \u06a9\u0645\u067e\u06cc\u0646\u200c\u0647\u0627 \u0648 \u0628\u0627\u0634\u06af\u0627\u0647 \u0645\u0634\u062a\u0631\u06cc\u0627\u0646 \u0634\u0645\u0627\u0633\u062a.","b2b.box-yalda-text3":"\u0628\u0627 \u0647\u062f\u06cc\u0647 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648\u060c \u0634\u0645\u0627 \u06cc\u06a9 \u0645\u062d\u0635\u0648\u0644 \u06a9\u0627\u0631\u0628\u0631\u062f\u06cc \u0648 \u0645\u062a\u0646\u0627\u0633\u0628 \u0628\u0627 \u0647\u0631 \u0633\u0646 \u0648 \u0633\u0644\u06cc\u0642\u0647 \u0631\u0627 \u0627\u0646\u062a\u062e\u0627\u0628 \u06a9\u0631\u062f\u0647\u200c\u0627\u06cc\u062f.","b2b.sub.title1":"\u0645\u062d\u062a\u0648\u0627\u06cc \u0628\u0647\u200c\u0631\u0648\u0632 \u0648 \u0645\u062a\u0646\u0648\u0639:","b2b.sub.title2":"\u0633\u0647 \u0639\u0636\u0648\u06cc\u062a \u062c\u062f\u0627\u06af\u0627\u0646\u0647:","b2b.sub.title3":"\u062a\u0645\u0627\u0633 \u0628\u0627 \u0641\u06cc\u0644\u06cc\u0645\u0648:","b2b.title1":"\u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0648 \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0641\u06cc\u0644\u06cc\u0645\u0648","b2b.title2":"\u0686\u0631\u0627 \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648\u061f ","b2b.title3":"\u0627\u0646\u0648\u0627\u0639 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648","b2b.title4":"\u062e\u0631\u06cc\u062f \u0627\u0634\u062a\u0631\u0627\u06a9 \u0633\u0627\u0632\u0645\u0627\u0646\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 ","b2b.title5":"\u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u06a9\u062f \u062a\u062e\u0641\u06cc\u0641 \u0648 \u06a9\u0627\u0631\u062a \u0647\u062f\u06cc\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648","backArrow":"\u0631\u0641\u062a\u0646 \u0628\u0647 \u0627\u0633\u0644\u0627\u06cc\u062f\u0631 \u0642\u0628\u0644\u06cc","black_logo_descr":"\u0632\u0645\u0627\u0646\u06cc \u06a9\u0647 \u0644\u0648\u06af\u0648\u06cc \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0627 \u0631\u0646\u06af \u0627\u0635\u0644\u06cc \u0631\u0648\u06cc \u067e\u0633\u200c\u0632\u0645\u06cc\u0646\u0647\u200c\u0647\u0627\u06cc \u0631\u