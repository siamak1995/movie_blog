062e\u0644\u06cc","showroom.filimobox.data.two":"\u067e\u0631\u062f\u0627\u0632\u0646\u062f\u0647 \u06f4 \u0647\u0633\u062a\u0647 \u0627\u06cc \u0648 2GB RAM","showroom.filimobox.text":"\u0641\u06cc\u0644\u06cc\u0645\u0648\u0628\u0627\u06a9\u0633 \u062c\u062f\u06cc\u062f\u062a\u0631\u06cc\u0646 \u0645\u062d\u0635\u0648\u0644 \u067e\u0644\u062a\u0641\u0631\u0645 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0647\u200c \u0647\u0645\u0631\u0627\u0647 \u06f3 \u0645\u0627\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0648 \u0631\u06cc\u0645\u0648\u062a \u06a9\u0646\u062a\u0631\u0644 \u0628\u0644\u0648\u062a\u0648\u062b \u0628\u0627\u0642\u0627\u0628\u0644\u06cc\u062a \u062c\u0633\u062a\u062c\u0648\u06cc \u0635\u0648\u062a\u06cc \u0639\u0631\u0636\u0647 \u0645\u06cc \u06af\u0631\u062f\u062f.","showroom.filimostick.data.one":"\u0642\u0627\u0628\u0644\u06cc\u062a \u067e\u062e\u0634 \u062a\u0635\u0627\u0648\u06cc\u0631 \u0628\u0627 \u0648\u0636\u0648\u062d 4K","showroom.filimostick.data.three":"\u062f\u0627\u0631\u0627\u06cc \u067e\u0648\u0631\u062a HDMI \u0628\u0647 \u0647\u0645\u0631\u0627\u0647 8GB \u062d\u0627\u0641\u0638\u0647 \u062f\u0627\u062e\u0644\u06cc","showroom.filimostick.data.two":"\u067e\u0631\u062f\u0627\u0632\u0646\u062f\u0647 \u06f4 \u0647\u0633\u062a\u0647 \u0627\u06cc \u0648 1GB RAM","showroom.filimostick.text":"\u0641\u06cc\u0644\u06cc\u0645\u0648\u0627\u0633\u062a\u06cc\u06a9 \u062c\u062f\u06cc\u062f\u062a\u0631\u06cc\u0646 \u0645\u062d\u0635\u0648\u0644 \u067e\u0644\u062a\u0641\u0631\u0645 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u0633\u062a \u06a9\u0647 \u0628\u0647\u200c \u0647\u0645\u0631\u0627\u0647 \u06f3 \u0645\u0627\u0647 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0631\u0627\u06cc\u06af\u0627\u0646 \u0648 \u0631\u06cc\u0645\u0648\u062a \u06a9\u0646\u062a\u0631\u0644 \u0628\u0644\u0648\u062a\u0648\u062b \u0628\u0627 \u0642\u0627\u0628\u0644\u06cc\u062a \u062c\u0633\u062a\u062c\u0648\u06cc \u0635\u0648\u062a\u06cc \u0639\u0631\u0636\u0647 \u0645\u06cc \u06af\u0631\u062f\u062f.","showroom.header.title":"\u0641\u0631\u0648\u0634\u06af\u0627\u0647 \u0645\u062d\u0635\u0648\u0644\u0627\u062a \u0641\u06cc\u0644\u06cc\u0645\u0648","showroom.jeyran.necklaces.text":"\u06af\u0631\u062f\u0646\u0628\u0646\u062f \u0645\u0647\u0631 \u0648 \u0645\u0627\u0647 \u0628\u0631\u0627\u06cc \u0637\u0631\u0641\u062f\u0627\u0631\u0647\u0627 \u0648 \u0647\u0648\u0627\u062f\u0627\u0631\u0647\u0627\u06cc \u0633\u0631\u06cc\u0627\u0644 \u062c\u06cc\u0631\u0627\u0646 \u0631\u0633\u06cc\u062f. \u0628\u0627 \u0633\u0641\u0627\u0631\u0634 \u0648 \u062e\u0631\u06cc\u062f \u0627\u06cc\u0646 \u06af\u0631\u062f\u0646\u0628\u0646\u062f \u06cc\u0647 \u06cc\u0627\u062f\u06af\u0627\u0631\u06cc \u0632\u06cc\u0628\u0627 \u0627\u0632 \u0633\u0631\u06cc\u0627\u0644 \u0639\u0627\u0634\u0642\u0627\u0646\u0647 \u062c\u06cc\u0631\u0627\u0646 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0628\u0647 \u0647\u0645\u0631\u0627\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc\u0646. \u0628\u0631\u0627\u06cc \u0633\u0641\u0627\u0631\u0634 \u06a9\u0627\u0641\u06cc\u0647 \u0631\u0648\u06cc \u062f\u06a9\u0645\u0647 \u0632\u06cc\u0631 \u06a9\u0644\u06cc\u06a9 \u06a9\u0646\u06cc\u0646 \u062a\u0627 \u062f\u0631 \u0627\u0633\u0631\u0639 \u0648\u0642\u062a \u0628\u0647 \u062f\u0633\u062a\u062a\u0648\u0646 \u0628\u0631\u0633\u0647.","showroom.jeyrantshirt.text":"\u062a\u06cc\u200c\u0634\u0631\u062a\u200c\u0647\u0627\u06cc \u0633\u0631\u06cc\u0627\u0644 \u0645\u062d\u0628\u0648\u0628 \u062c\u06cc\u0631\u0627\u0646 \u0628\u0631\u0627\u06cc \u0647\u0648\u0627\u062f\u0627\u0631\u0647\u0627\u06cc \u0627\u06cc\u0646 \u0633\u0631\u06cc\u0627\u0644 \u0639\u0627\u0634\u0642\u0627\u0646\u0647 \u0628\u0627 \u0637\u0631\u062d \u0648 \u0646\u0642\u0634\u200c\u0647\u0627\u06cc \u0645\u062a\u0646\u0648\u0639 \u0648 \u062f\u0631 \u0633\u0627\u06cc\u0632\u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641 \u062a\u0648\u0644\u06cc\u062f \u0634\u062f \u0648 \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc\u062f \u0628\u0631\u0627\u06cc \u062e\u0631\u06cc\u062f \u062a\u06cc\u200c\u0634\u0631\u062a \u0645\u0648\u0631\u062f \u0646\u0638\u0631\u062a\u0648\u0646 \u0627\u0642\u062f\u0627\u0645 \u06a9\u0646\u06cc\u0646.","showroom.jeyrantshirts":"\u062a\u06cc\u200c\u0634\u0631\u062a\u200c\u0647\u0627\u06cc \u0633\u0631\u06cc\u0627\u0644 \u062c\u06cc\u0631\u0627\u0646","showroom.mafiaboardGame.text":"\u0627\u06af\u0631 \u0628\u0647 \u0631\u0626\u0627\u0644\u06cc\u062a\u06cc\u200c\u0634\u0648 \u0634\u0628\u200c\u0647\u0627\u06cc \u0645\u0627\u0641\u06cc\u0627 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0648 \u0628\u0627\u0632\u06cc \u0645\u062d\u0628\u0648\u0628 \u062c\u0647\u0627\u0646\u06cc \u0645\u0627\u0641\u06cc\u0627 \u0639\u0644\u0627\u0642\u0647\u200c\u0645\u0646\u062f \u0647\u0633\u062a\u06cc\u062f\u060c \u0647\u0645\u200c\u0627\u06a9\u0646\u0648\u0646 \u0645\u06cc\u200c\u062a\u0648\u0627\u0646\u06cc\u062f \u0628\u0627 \u062a\u0647\u06cc\u0647 \xab\u0628\u0631\u062f \u06af\u06cc\u0645 \u0628\u0627\u0632\u06cc\u200c \u0645\u0627\u0641\u06cc\u0627 \u0641\u06cc\u0644\u06cc\u0645\u0648\xbb \u062f\u0631 \u06a9\u0646\u0627\u0631 \u062e\u0627\u0646\u0648\u0627\u062f\u0647 \u0648 \u062f\u0648\u0633\u062a\u0627\u0646 \u062e\u0648\u062f \u0627\u0632 \u0627\u06cc\u0646 \u0628\u0627\u0632\u06cc \u0644\u0630\u062a \u0628\u0628\u0631\u06cc\u062f","showroom.yaghibracelet.text":"\u0627\u06cc\u0646 \u062f\u0633\u062a\u0628\u0646\u062f \u06a9\u0647 \u0645\u06cc\u200c\u0628\u06cc\u0646\u06cc\u062f \u0627\u0632 \u062c\u0646\u06af\u0644\u200c\u0647\u0627\u06cc \u0644\u06cc\u0627\u0646\u06af \u0634\u0627\u0646 \u067e\u0648 \u0622\u0645\u062f\u0647 \u0627\u0633\u062a. \u062f\u0633\u062a\u0628\u0646\u062f \u0686\u0631\u0645\u06cc \u0633\u0631\u06cc\u0627\u0644 \u0632\u06cc\u0628\u0627 \u0648 \u0645\u062d\u0628\u0648\u0628 \u067e\u0631\u0628\u06cc\u0646\u0646\u062f\u0647\u200c\u062a\u0631\u06cc\u0646 \u0633\u0631\u06cc\u0627\u0644 \u0634\u0628\u06a9\u0647 \u0646\u0645\u0627\u06cc\u0634 \u062e\u0627\u0646\u06af\u06cc \u0631\u0648 \u0645\u06cc\u200c\u062a\u0648\u0646\u06cc\u062f \u0647\u0645\u06cc\u0646 \u0627\u0644\u0627\u0646 \u0633\u0641\u0627\u0631\u0634 \u0628\u062f\u06cc\u062f\u060c \u0627\u0644\u0628\u062a\u0647 \u0634\u0631\u0637 \u062e\u0631\u06cc\u062f \u0627\u06cc\u0646 \u062f\u0633\u062a\u0628\u0646\u062f \u0627\u06cc\u0646\u0647 \u06a9\u0647 \u0627\u06cc\u0646\u0647 \u06a9\u0647 \u0634\u0645\u0627\u0645 \u0645\u062b\u0644 \u062c\u0627\u0648\u06cc\u062f \u0642\u0635\u0647 \u0645\u0627 \u06cc\u0627\u063a\u06cc \u0639\u0634\u0642 \u0648 \u0632\u0646\u062f\u06af\u06cc \u0628\u0627\u0634\u06cc\u0646","showroom.yaghinecklaces.text":"\u0645\u0646 \u06cc\u0627\u063a\u06cc \u0639\u0634\u0642\u0645 \u0645\u0646\u060c \u06cc\u0627\u063a\u06cc \u0632\u0646\u062f\u06af\u06cc\u200c\u0627\u0645! \u06af\u0631\u062f\u0646\u0628\u0646\u062f \u06cc\u0627\u063a\u06cc \u0628\u0631\u0627\u06cc \u0637\u0631\u0641\u062f\u0627\u0631\u0647\u0627\u06cc \u0628\u06cc\u200c\u0634\u0645\u0627\u0631 \u0627\u06cc\u0646 \u0634\u0627\u0647\u06a9\u0627\u0631 \u0646\u0645\u0627\u06cc\u0634 \u062e\u0627\u0646\u06af\u06cc \u0647\u0645 \u0628\u0647 \u0628\u0627\u0632\u0627\u0631 \u0627\u0648\u0645\u062f\u060c \u0627\u0632 \u0647\u0645\u06cc\u0646 \u0627\u0645\u0631\u0648\u0632 \u0645\u06cc \u062a\u0648\u0646\u06cc\u062f \u0628\u0627 \u062b\u0628\u062a \u0633\u0641\u0627\u0631\u0634 \u0648 \u062e\u0631\u06cc\u062f \u0627\u06cc\u0646 \u06af\u0631\u062f\u0646\u0628\u0646\u062f \u0632\u06cc\u0628\u0627 \u06cc\u0627\u062f \u0648 \u062e\u0627\u0637\u0631\u0647 \u0639\u0634\u0642 \u0627\u064e\u0628\u0631\u0627 \u0648 \u062c\u0627\u0648\u06cc\u062f \u0631\u0648 \u0628\u0631\u0627\u06cc \u0647\u0645\u06cc\u0634\u0647 \u0628\u0647 \u0647\u0645\u0631\u0627\u0647 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u06cc.","showroom.yaghitshirt.text":"  \u062a\u06cc\u200c\u0634\u0631\u062a\u200c\u0647\u0