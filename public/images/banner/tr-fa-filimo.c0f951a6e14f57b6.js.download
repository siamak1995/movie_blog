9\u0627\u0646 \u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc \u0645\u062c\u062f\u062f \u0627\u06cc\u0646 \u0633\u0631\u0648\u06cc\u0633 \u0631\u0627 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a.","term_payment_item5":"\u0627\u0645\u06a9\u0627\u0646 \u062d\u0630\u0641 \u0627\u06a9\u0627\u0646\u062a \u062f\u0631 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f \u0648\u0644\u06cc \u0627\u0645\u06a9\u0627\u0646 \u063a\u06cc\u0631\u0641\u0639\u0627\u0644\u200c\u0633\u0627\u0632\u06cc \u0627\u06a9\u0627\u0646\u062a \u062a\u0648\u0633\u0637 \u062e\u0648\u062f \u06a9\u0627\u0631\u0628\u0631 \u0648\u062c\u0648\u062f \u062f\u0627\u0631\u062f.","term_payment_item6":"\u0627\u0645\u06a9\u0627\u0646 \u0627\u0646\u062a\u0642\u0627\u0644 \u0627\u0634\u062a\u0631\u0627\u06a9 \u0627\u0632 \u06cc\u06a9 \u06a9\u0627\u0631\u0628\u0631\u06cc \u0628\u0647 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062f\u06cc\u06af\u0631 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f.","term_payment_item7":"\u062f\u0631 \u0647\u0631 \u062e\u0631\u06cc\u062f \u0627\u0645\u06a9\u0627\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0628\u06cc\u0634 \u0627\u0632 \u06cc\u06a9 \u062a\u062e\u0641\u06cc\u0641 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f. \u0645\u06cc\u0632\u0627\u0646 \u062a\u062e\u0641\u06cc\u0641 \u0646\u0647\u0627\u06cc\u06cc \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u0647\u0648\u0634\u0645\u0646\u062f \u062a\u0648\u0633\u0637 \u0633\u06cc\u0633\u062a\u0645 \u0645\u062d\u0627\u0633\u0628\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0647\u0627\u06cc \u0645\u062e\u062a\u0644\u0641 \u0645\u062a\u0641\u0627\u0648\u062a \u062e\u0648\u0627\u0647\u062f \u0628\u0648\u062f.","term_payment_item8":"\u062c\u0647\u062a \u062a\u0645\u0627\u0634\u0627\u06cc \u0641\u06cc\u0644\u0645 \u0648 \u0633\u0631\u06cc\u0627\u0644 \u062f\u0631 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0627\u06cc\u062f \u062f\u0633\u062a\u06af\u0627\u0647 \u062d\u062f\u0627\u0642\u0644 \u0633\u062e\u062a\u200c\u0627\u0641\u0632\u0627\u0631 \u0648 \u0646\u0631\u0645\u200c\u0627\u0641\u0632\u0627\u0631 \u0645\u0648\u0631\u062f \u0631\u0627 \u0646\u06cc\u0627\u0632 \u0631\u0627 \u062f\u0627\u0634\u062a\u0647 \u0628\u0627\u0634\u062f. \u0637\u0628\u06cc\u0639\u06cc \u0627\u0633\u062a \u062a\u0644\u0648\u06cc\u0632\u06cc\u0648\u0646\u200c\u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc \u0648 \u0633\u06cc\u0633\u062a\u0645\u200c\u0647\u0627\u06cc \u0642\u062f\u06cc\u0645\u06cc \u0627\u0645\u06a9\u0627\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u062a\u0645\u0627\u0645 \u0627\u0645\u06a9\u0627\u0646\u0627\u062a \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0631\u0627 \u0646\u062f\u0627\u0631\u0646\u062f.","term_payment_item9":"\u0627\u0645\u06a9\u0627\u0646 \u0639\u0648\u062f\u062a \u0645\u0628\u0644\u063a \u0627\u0634\u062a\u0631\u0627\u06a9 \u062e\u0631\u06cc\u062f\u0647 \u0634\u062f\u0647 \u0648\u062c\u0648\u062f \u0646\u062f\u0627\u0631\u062f.","term_payment_title":"\u0642\u0648\u0627\u0646\u06cc\u0646 \u0633\u0631\u0648\u06cc\u0633 \u067e\u0631\u062f\u0627\u062e\u062a \u0628\u0627 \u062a\u0645\u062f\u06cc\u062f \u062e\u0648\u062f\u06a9\u0627\u0631","term_phone_title":"\u0634\u0645\u0627\u0631\u0647 \u062a\u0645\u0627\u0633:","term_privacy_passage1":"\u062f\u0631 \u0627\u06cc\u0646 \u0628\u062e\u0634 \u0628\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u062a\u0648\u0636\u06cc\u062d \u062e\u0648\u0627\u0647\u06cc\u0645 \u062f\u0627\u062f \u06a9\u0647 \u0627\u0632 \u0627\u06cc\u0634\u0627\u0646 \u0686\u0647 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u062c\u0645\u0639\u200c\u0622\u0648\u0631\u06cc \u0645\u06cc\u200c\u0634\u0648\u062f \u0648 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0628\u0627 \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0686\u06af\u0648\u0646\u0647 \u0628\u0631\u062e\u0648\u0631\u062f \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f. \u0634\u0627\u06cc\u0627\u0646 \u0630\u06a9\u0631 \u0627\u0633\u062a \u06a9\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0647\u0645\u0648\u0627\u0631\u0647 \u0627\u0635\u0648\u0644 \u0645\u062d\u0631\u0645\u0627\u0646\u06af\u06cc \u0631\u0627 \u062f\u0631 \u0645\u0648\u0631\u062f \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u06a9\u0627\u0631\u0628\u0631 \u0631\u0627 \u0631\u0639\u0627\u06cc\u062a \u06a9\u0631\u062f\u0647 \u0648 \u0627\u0632 \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u0647 \u0646\u062d\u0648 \u0627\u062d\u0633\u0646 \u0645\u062d\u0627\u0641\u0638\u062a \u0645\u06cc\u200c\u0646\u0645\u0627\u06cc\u062f. \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0634\u062e\u0635\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0631\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0627\u0634\u062e\u0627\u0635 \u062b\u0627\u0644\u062b \u0642\u0631\u0627\u0631 \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u062f. \u0627\u0644\u0628\u062a\u0647 \u0628\u0647\u200c\u0627\u0633\u062a\u062b\u0646\u0627\u06cc \u0645\u0648\u0627\u0631\u062f\u06cc \u06a9\u0647 \u0628\u0647\u200c\u0645\u0648\u062c\u0628 \u0642\u0627\u0646\u0648\u0646 \u0645\u0648\u0638\u0641 \u0628\u0647 \u0627\u0646\u062c\u0627\u0645 \u0627\u06cc\u0646 \u06a9\u0627\u0631 \u0628\u0627\u0634\u062f. \u0686\u0646\u0627\u0646\u0686\u0647 \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u0647\u200c\u0635\u0648\u0631\u062a \u063a\u06cc\u0631\u0639\u0645\u062f \u06cc\u0627 \u0628\u062f\u0648\u0646 \u0627\u0637\u0644\u0627\u0639 \u0648 \u0631\u0636\u0627\u06cc\u062a \u0645\u0627 \u062f\u0631 \u062f\u0633\u062a\u0631\u0633 \u0634\u062e\u0635 \u062b\u0627\u0644\u062b\u06cc \u0642\u0631\u0627\u0631 \u06af\u06cc\u0631\u062f\u060c \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0645\u0633\u0626\u0648\u0644\u06cc\u062a\u06cc \u0646\u062e\u0648\u0627\u0647\u062f \u062f\u0627\u0634\u062a","term_privacy_passage2":"\u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u06a9\u0647 \u0634\u0645\u0627 \u062f\u0631 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0642\u0631\u0627\u0631 \u0645\u06cc\u200c\u062f\u0647\u06cc\u062f \u0628\u062f\u06cc\u0646\u200c\u06af\u0648\u0646\u0647 \u0627\u0633\u062a \u06a9\u0647 \u062f\u0631 \u0641\u0631\u0622\u06cc\u0646\u062f \u062b\u0628\u062a\u200c\u0646\u0627\u0645\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0645\u0631\u0628\u0648\u0637 \u0628\u0647 \u06a9\u0627\u0631\u0628\u0631 \u0634\u0627\u0645\u0644 \u0646\u0627\u0645 \u0648 \u0646\u0627\u0645 \u062e\u0627\u0646\u0648\u0627\u062f\u06af\u06cc\u060c \u0622\u062f\u0631\u0633 \u0627\u06cc\u0645\u06cc\u0644 \u0648 \u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a \u0645\u06cc\u200c\u06af\u0631\u062f\u062f \u0648 \u062f\u0631 \u067e\u0627\u06cc\u0627\u0646 \u0627\u06cc\u0645\u06cc\u0644\u06cc \u062c\u0647\u062a \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u06a9\u0627\u0631\u0628\u0631 \u0628\u0647 \u0622\u062f\u0631\u0633 \u0627\u06cc\u0645\u06cc\u0644 \u0627\u0639\u0644\u0627\u0645 \u0634\u062f\u0647 \u0627\u0632 \u0637\u0631\u0641 \u0648\u06cc \u0641\u0631\u0633\u062a\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u062f. \u062f\u0631 \u0635\u0648\u0631\u062a \u062b\u0628\u062a\u200c\u0646\u0627\u0645\u060c \u0628\u0627 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u0627\u0632 \u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc \u062f\u0631 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0627\u0632 \u0642\u0628\u06cc\u0644 \'\u0641\u06cc\u0644\u0645\u200c\u0647\u0627\u06cc \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u0634\u062f\u0647\'\u060c \'\u0648\u06cc\u0631\u0627\u06cc\u0634 \u0645\u0634\u062e\u0635\u0627\u062a\'\u060c \'\u0641\u06cc\u0644\u0645\u200c\u0647\u0627\u06cc \u062f\u06cc\u062f\u0647 \u0634\u062f\u0647\' \u0648 \'\u0633\u0648\u0627\u0628\u0642 \u067e\u0631\u062f\u0627\u062e\u062a\' \u0646\u0645\u0627\u06cc\u0634 \u062f\u0627\u062f\u0647 \u0645\u06cc\u200c\u0634\u0648\u0646\u062f. \u062f\u0631 \u0642\u0633\u0645\u062a \u0648\u06cc\u0631\u0627\u06cc\u0634 \u0645\u0634\u062e\u0635\u0627\u062a\u060c \u06a9\u0627\u0631\u0628\u0631 \u0642\u0627\u062f\u0631 \u0627\u0633\u062a \u062a\u0627 \u062f\u0631 \u0635\u0648\u0631\u062a \u062a\u0645\u0627\u06cc\u0644\u060c \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0646\u0638\u06cc\u0631 \'\u0646\u0627\u0645 (\u0628\u0647 \u0641\u0627\u0631\u0633\u06cc) \'\u060c \'\u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647\'\u060c \'\u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc\' \u0648 \'\u0627\u06cc\u0645\u06cc\u0644\' \u0631\u0627 \u0628\u0647\u200c\u0631\u0648\u0632\u0631\u0633\u0627\u0646\u06cc \u06a9\u0646\u062f.","term_privacy_passage3":"\u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u06a9\u0647 \u0627\u0632 \u062d\u0633\u0627\u0628 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0628\u0647 \u0637\u0648\u0631 \u062e\u0648\u062f\u06a9\u0627\u0631 \u0628\u062f\u0633\u062a \u0645\u06cc\u200c\u0622\u0648\u0631\u062f \u062c\u0647\u062a \u062a\u062d\u0644\u06cc\u0644\u060c \u0628\u0631\u0631\u0633\u06cc \u0648 \u0634\u062e\u0635\u06cc\u200c\u0633\u0627\u0632\u06cc \u062e\u062f\u0645\u0627\u062a \u062e\u0648\u062f \u0648 \u0627\u0631\u0627\u0626\u0647 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f\u0627\u062a \u0648\u06cc\u0698\u0647\u0654 \u0646\u0632\u062f\u06cc\u06a9\u200c\u062a\u0631 \u0628\u0647 \u0633\u0644\u06cc\u0642\u0647 \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0627\u0633\u062a\u0641\u0627\u062f\u0647 \u062e\u0648\u0627\u0647\u062f \u06a9\u0631\u062f. \u0627\u06cc\u0646 \u0627\u0637\u0644\u0627\u0639\u0627\u062a \u0628\u0647 \u0641\u06cc\u0644\u06cc\u0645\u0648 \u06a9\u0645\u06a9 \u0645\u06cc\u200c\u06a9\u0646\u062f \u062a\u0627 \u0633\u0631\u0648\u06cc\u0633 \u062e\u0648\u062f \u0631\u0627 \u0628\u0647\u0628\u0648\u062f \u0628\u062e\u0634\u06cc\u062f\u0647 \u0648 \u0645\u062d\u062a\u0648\u0627\u06cc \u0645\u0631\u062a\u0628\u0637\u200c\u062a\u0631\u06cc \u0628\u0627 \u0639\u0644\u0627\u06cc\u0642 \u0647\u0631 \u06a9\u0627\u0631\u0628\u0631 \u0628\u0647 \u0627\u06cc\u0634\u0627\u0646 \u0627\u0631\u0627\u0626\u0647 \u06a9\u0646\u062f.","term_privacy_passage4":"\u0641\u06cc\u0644\u06cc\u0645\u0648 \u0627\u06cc\u0646 \u0627\u062e\u062a\u06cc\u0627\u0631 \u0631\u0627 \u062f\u0627\u0631\u062f\u060c \u0647\u0646\u06af\u0627\u0645 \u067e\u062e\u0634 \u0641\u06cc\u0644\u0645 \u0628\u0647 \u0641\u0631\u0627\u062e\u0648\u0631 \u0632\u0645\u0627\u0646 \u0648 \u0645\u062d\u062a\u0648\u0627\u060c \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631 \u062a\u0628\u0644\u06cc\u063a \u0646\u0645\u0627\u06cc\u0634 \u062f\u0647\u062f.","term_privacy_passage5":"\u0641\u06cc\u0644\u06cc\u0645\u0648 \u062c\u0647\u062a \u0627\u0631\u0627\u0626\u0647 \u0628\u0647\u062a\u0631 \u0633\u0631\u0648\u06cc\u0633 \u062e\u0648\u062f \u0648 \u0627\u0637\u0644\u0627\u0639\u200c\u0631\u0633\u0627\u0646\u06cc \u062f\u0631 \u062e\u0635\u0648\u0635 \u0637\u0631\u062d\u200c\u0647\u0627\u06cc \u0648\u06cc\u0698\u0647 \u0648 \u067e\u06cc\u0634\u0646\u0647\u0627\u062f \u062a\u0645\u0627\u0634\u0627\u06cc \u0641\u06cc\u0644\u0645\u200c\u0647\u0627\u06cc \u062c\u062f\u06cc\u062f \u0648 ... \u0645\u0645\u06a9\u0646 \u0627\u0633\u062a \u0627\u0632 \u0637\u0631\u06cc\u0642 \u0627\u06cc\u0645\u06cc\u0644 \u06cc\u0627 \u0634\u0645\u0627\u0631\u0647 \u062a\u0644\u0641\u0646 \u0647\u0645\u0631\u0627\u0647 \u062b\u0628\u062a \u0634\u062f\u0647\u060c \u0627\u0642\u062f\u0627\u0645 \u0628\u0647 \u0627\u0631\u0633\u0627\u0644 \u0627\u0637\u0644\u0627\u0639\u0627\u062a\u06cc \u0628\u0631\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0646\u0645\u0627\u06cc\u062f. \u0634\u0645\u0627 \u0647\u0645\u0648\u0627\u0631\u